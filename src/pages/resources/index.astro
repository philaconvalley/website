---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingFlock from '../../components/ClosingFlock.astro';
import { getCollection } from 'astro:content';
import { links } from '../../config';

/**
 * Resources, Edition 1.2 (DESIGN.md, "The 1.2 redesign"). Sections follow
 * Diego's mockup, with these decisions (Waskar, 10/17/2026):
 * - Each card uses the guide file's own copy (src/content/resources), the same
 *   rule as the Arcade. A tag that repeats the level is not shown.
 * - A filter appears only when it has two or more choices. With one guide,
 *   neither shows, and neither does the count; they appear on their own as
 *   guides are added. The old
 *   search box is gone, as in the mockup.
 * - "Contribute a resource" goes to the contribution guide on GitHub, and the
 *   "Your guide here" card says a guide is published after a review.
 * - Card titles are h2, so the heading order no longer skips from h1 to h3
 *   (10/2026 polish audit).
 */

const resources = (await getCollection('resources')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const categories = [...new Set(resources.map((r) => r.data.category))];
const levels = [...new Set(resources.map((r) => r.data.level))];
const showCategory = categories.length > 1;
const showLevel = levels.length > 1;
const filtered = showCategory || showLevel;

const countLabel = (n: number) => `${n} ${n === 1 ? 'resource' : 'resources'}`;

const cards = resources.map((r) => ({
  slug: r.id,
  ...r.data,
  tags: r.data.tags.filter((tag) => tag.toLowerCase() !== r.data.level.toLowerCase()),
}));

const guide = `${links.github.website}/blob/main/docs/adding-content.md#adding-a-resource`;
---

<BaseLayout
  title="Resources — Free tech guides written by the PhilaCon Valley community"
  description="Free tutorials and walkthroughs for building tech skills, whether you're brand new or leveling up. Every one is free and community-made."
>
  <!-- Hero: white, as in the mockup. -->
  <section class="bg-white">
    <div class="container-custom py-[clamp(56px,8vw,112px)] flex flex-col gap-7">
      <p class="m-0 self-start pill bg-brand-yellow font-black text-[13px] tracking-[0.16em]">
        Learning resources
      </p>
      <h1 class="m-0 max-w-[900px]">Free guides, written by the flock.</h1>
      <p class="m-0 max-w-[600px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
        Tutorials and walkthroughs for building tech skills, whether you're brand new or leveling
        up. Every one is free and community-made.
      </p>
    </div>
  </section>

  <!-- The guides: Golden Yellow, with a dashed card inviting a new one. -->
  <section class="bg-brand-yellow border-t-2 border-brand-dark">
    <div
      class="container-custom py-[clamp(56px,7vw,96px)] flex flex-col gap-10"
      x-data={
        filtered
          ? `{
            category: 'all',
            level: 'all',
            shown: ${resources.length},
            apply() {
              let n = 0;
              this.$root.querySelectorAll('[data-resource]').forEach((card) => {
                const ok = (this.category === 'all' || card.dataset.category === this.category) &&
                  (this.level === 'all' || card.dataset.level === this.level);
                card.hidden = !ok;
                if (ok) n++;
              });
              this.shown = n;
            }
          }`
          : undefined
      }
    >
      {/* The filters and their count show only with two or more choices. With
          one guide, a lone "1 resource" made the page look empty (site audit,
          10/18/2026). */}
      {filtered && (
        <div class="flex flex-wrap items-end gap-4">
          {showCategory && (
            <label class="flex flex-col gap-2 font-black text-[13px] tracking-[0.2em] uppercase">
              Category
              <select
                x-model="category"
                @change="apply()"
                class="min-h-11 min-w-[200px] px-4 rounded-[14px] border-2 border-brand-dark bg-white font-display font-bold text-sm normal-case tracking-normal text-brand-dark"
              >
                <option value="all">All categories</option>
                {categories.map((c) => (
                  <option value={c}>{c}</option>
                ))}
              </select>
            </label>
          )}
          {showLevel && (
            <label class="flex flex-col gap-2 font-black text-[13px] tracking-[0.2em] uppercase">
              Level
              <select
                x-model="level"
                @change="apply()"
                class="min-h-11 min-w-[200px] px-4 rounded-[14px] border-2 border-brand-dark bg-white font-display font-bold text-sm normal-case tracking-normal text-brand-dark"
              >
                <option value="all">All levels</option>
                {levels.map((l) => (
                  <option value={l}>{l}</option>
                ))}
              </select>
            </label>
          )}
          <p
            class="m-0 min-h-11 inline-flex items-center font-black text-sm"
            aria-live="polite"
            data-testid="resource-count"
          >
            <span x-text={`shown === 1 ? '1 resource' : shown + ' resources'`}>
              {countLabel(resources.length)}
            </span>
          </p>
        </div>
      )}

      <ul class="m-0 p-0 list-none grid gap-7 grid-cols-1 lg:grid-cols-3">
        {cards.map((card) => (
          <li
            class:list={[cards.length === 1 && 'lg:col-span-2']}
            data-resource
            data-category={card.category}
            data-level={card.level}
          >
            <a
              href={`/resources/${card.slug}`}
              class="card h-full !border-brand-dark p-[clamp(24px,3vw,36px)] flex flex-col gap-4 text-brand-dark no-underline"
              aria-label={`Read the guide: ${card.title} (${card.category}, ${card.level})`}
            >
              <p class="m-0 flex flex-wrap gap-2">
                <span class="pill bg-brand-pink">{card.category}</span>{' '}
                <span class="pill bg-brand-amber">{card.level}</span>
              </p>{' '}
              <h2 class="m-0 text-[clamp(32px,4.4vw,63px)] leading-[0.95]">{card.title}</h2>{' '}
              <p class="m-0 text-[18px] leading-[1.55]">{card.description}</p>{' '}
              {card.tags.length > 0 && (
                <ul class="m-0 p-0 list-none flex flex-wrap gap-2" aria-label="Tags">
                  {card.tags.map((tag) => (
                    <li class="pill normal-case tracking-normal text-xs">{tag}</li>
                  ))}
                </ul>
              )}{' '}
              <div class="mt-auto pt-4 border-t-2 border-brand-dark flex flex-wrap items-center justify-between gap-3">
                <span class="font-extrabold text-sm tracking-[0.14em] uppercase">
                  By {card.author}
                </span>{' '}
                <span class="font-black text-[17px] underline underline-offset-[5px] decoration-2">
                  Read the guide
                </span>
              </div>
            </a>
          </li>
        ))}
        <li>
          <div
            class="h-full rounded-retro border-2 border-dashed border-brand-dark p-7 flex flex-col justify-center gap-4"
            data-testid="your-guide-here"
          >
            <h2 class="m-0 text-[clamp(28px,2.6vw,36px)] leading-[0.95]">Your guide here.</h2>
            <p class="m-0 text-[15px] leading-[1.55]">
              Know something worth teaching? Write it up, and after a quick review we'll publish it
              for the whole flock.
            </p>
            <a
              href={guide}
              target="_blank"
              rel="noopener noreferrer"
              class="self-start inline-flex items-center min-h-11 font-black text-[15px] text-brand-dark underline underline-offset-[5px] decoration-2"
            >
              Contribute a resource
            </a>
          </div>
        </li>
      </ul>

      {filtered && (
        <p x-show="shown === 0" x-cloak class="m-0 text-lg font-semibold">
          No guides match these filters. Choose "All" to see every guide.
        </p>
      )}

      {resources.length === 0 && (
        <p class="m-0 text-lg font-semibold">
          No guides yet. The first one could be yours: the dashed card shows how to add it.
        </p>
      )}
    </div>
  </section>

  <!-- The Resources closing, in the mockup's copy. -->
  <ClosingFlock
    lede="The best guides come from people who just figured it out. Yours could help the next person in the room."
    primary={{ href: guide, label: 'Contribute a resource', external: true }}
    secondary={{ href: '/join', label: 'Join the community' }}
  >
    Share what you know.
  </ClosingFlock>
</BaseLayout>
