---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, links } from '../config';

/**
 * Mode: Read. Budget: 400 body words (DESIGN.md — the 550 ceiling is About's,
 * bought for its values statement, not general headroom).
 *
 * The page describes what the code actually does, and nothing more. Each row in
 * `services` matches one thing a visitor's browser talks to:
 *   - Vercel Analytics  -> <Analytics /> in src/layouts/BaseLayout.astro
 *   - Formspree         -> the form on src/pages/contact.astro
 *   - Luma              -> the calendar iframe on src/pages/events/index.astro
 *
 * No font service is listed because there is none: pages self-host their fonts
 * from @fontsource and games embed theirs as data: URIs (#179). e2e/csp.spec.ts
 * fails if any policy allows Google Fonts again.
 *
 * If you add a script, an embed, or a form, add its row here in the same PR.
 * The CSP in vercel.json is the backstop: a third-party script that is not
 * allowed there cannot load, so a new tracker cannot appear without a diff to
 * that file. Treat a change to script-src, connect-src, frame-src, or font-src as a
 * change to this page too.
 */

const updated = 'October 12, 2026';

/** Source files are linked on GitHub, so every claim below can be checked. */
const source = (path: string) => `${links.github.website}/blob/main/${path}`;
const history = `${links.github.website}/commits/main/src/pages/privacy.astro`;

/**
 * Every outside site this one links to, with that site's own policy. Keep in
 * step with the outbound links in Footer.astro, contact.astro, and support.astro.
 */
const linkedSites = [
  { name: 'Discord', policy: 'https://discord.com/privacy' },
  {
    name: 'GitHub',
    policy:
      'https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement',
  },
  { name: 'Instagram', policy: 'https://privacycenter.instagram.com/policy' },
  { name: 'LinkedIn', policy: 'https://www.linkedin.com/legal/privacy-policy' },
  { name: 'Luma', policy: 'https://luma.com/privacy-policy' },
  { name: 'Open Collective', policy: 'https://opencollective.com/privacypolicy' },
  { name: 'X (Twitter)', policy: 'https://x.com/en/privacy' },
];

const services = [
  {
    name: 'Vercel Analytics',
    where: 'Every page',
    what: 'The page you visit, the site that sent you, your country, and your browser and device type. It sets no cookies. It does not store your IP address, and it cannot follow you across days or to other sites.',
    policy: 'https://vercel.com/docs/analytics/privacy-policy',
    code: 'src/layouts/BaseLayout.astro',
  },
  {
    name: 'Formspree',
    where: 'Contact page',
    what: 'The name, email, and message you type into the contact form, only when you press send. Formspree delivers it to our inbox. We use it to reply to you. We do not add you to a mailing list.',
    policy: 'https://formspree.io/legal/privacy-policy/',
    code: 'src/pages/contact.astro',
  },
  {
    name: 'Luma',
    where: 'Events page',
    what: 'The events calendar is a Luma window inside our page. Luma runs it, and Luma may set its own cookies. When you RSVP, you do so on Luma, under its terms.',
    policy: 'https://luma.com/privacy-policy',
    code: 'src/pages/events/index.astro',
  },
];
---

<BaseLayout
  title="Privacy - PhilaCon Valley"
  description="What this website collects, who receives it, and what we never do with it."
>
  <section class="bg-brand-coral text-white py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Privacy</h1>
        <p class="text-2xl text-white/85">No ad trackers. No data sales. Here is the full list.</p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-cream">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <p class="text-lg mb-4">
          This website runs no advertising pixels, no session recording, and no social media
          trackers. We do not sell or share your personal information, and we do not build profiles
          of visitors.
        </p>
        <p class="text-lg text-brand-dark/70">
          Three outside services touch your visit. Each one is listed below, with what it receives.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-bold mb-12">What leaves your browser</h2>
        <dl class="space-y-10 m-0">
          {services.map((service) => (
            <div>
              <dt class="font-display text-2xl font-bold mb-1">
                {service.name}
                <span class="block font-mono text-xs font-normal uppercase tracking-wide text-brand-dark/70 mt-1">
                  {service.where}
                </span>
              </dt>
              <dd class="m-0 text-lg text-brand-dark/70">
                {service.what}{' '}
                <a
                  href={service.policy}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline text-primary-600 hover:text-primary-700"
                >
                  {service.name} privacy policy
                </a>
                {' · '}
                <a
                  href={source(service.code)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline text-primary-600 hover:text-primary-700"
                >
                  See the code
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-yellow border-t-[3px]">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-bold mb-10">Your choices</h2>
        <dl class="space-y-10 m-0 text-lg">
          <div>
            <dt class="font-display text-2xl font-bold mb-1">See or delete your data</dt>
            <dd class="m-0">
              The only personal data we hold from this site is what you send through the contact
              form. Email{' '}
              <a href={`mailto:${site.email}`} class="underline font-semibold">
                {site.email}
              </a>{' '}
              to see it or to have it deleted.
            </dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-bold mb-1">Sites we link to</dt>
            <dd class="m-0">
              <p class="mb-3">
                These links leave our site. Each one opens that site's own privacy policy.
              </p>
              <ul class="flex flex-wrap gap-x-5 gap-y-2 m-0 p-0 list-none">
                {linkedSites.map((linked) => (
                  <li>
                    <a
                      href={linked.policy}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline font-semibold"
                    >
                      {linked.name}
                    </a>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-bold mb-1">Check our work</dt>
            <dd class="m-0">
              Our{' '}
              <a
                href={source('vercel.json')}
                target="_blank"
                rel="noopener noreferrer"
                class="underline font-semibold"
              >
                security policy
              </a>{' '}
              tells your browser to block any service not listed on this page. Every change to this
              page is public in its{' '}
              <a
                href={history}
                target="_blank"
                rel="noopener noreferrer"
                class="underline font-semibold"
              >
                change history
              </a>
              .
            </dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-bold mb-1">Children</dt>
            <dd class="m-0">This site is not directed at children under 13.</dd>
          </div>
        </dl>
        <p class="mt-10 font-mono text-sm text-brand-dark/70">Last updated {updated}</p>
      </div>
    </div>
  </section>
</BaseLayout>
