---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ClosingFlock from '../../components/ClosingFlock.astro';
import { getCollection } from 'astro:content';
import PartnerStrip from '../../components/PartnerStrip.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import StudioProof from '../../components/StudioProof.astro';
import { getRoomPhotos } from '../../lib/events';
import { getShowcase, isStudioLive } from '../../lib/showcase';

/**
 * Studio: the page for organizations that want to hire PhilaCon Valley
 * (Waskar, 10/18/2026). Support is for people who want to give; this page is
 * for people with a budget. Diego's redesign nav already names it.
 *
 * It sells like a product launch, not an agency brochure. The buyer is a
 * nonprofit with no tech staff, afraid of a site nobody can update after the
 * vendor leaves. So the page leads with that promise ("run by you"), shows
 * proof in the client's own hands and words, and asks for one thing.
 *
 * Client proof and partner logos appear only after each one approves
 * (src/lib/showcase.ts). The whole page waits for the first approved client
 * story: without proof it is only claims (Waskar, 10/18/2026).
 *
 * One loud heading (site audit, 10/18/2026): "Your budget does good twice."
 * is the page's argument, so it keeps the full size. The other section
 * headings are quiet.
 *
 * Steve Jobs review, 10/18/2026:
 * - A third offer, "We host", for events and activations (Waskar,
 *   10/18/2026). The heading says three ways.
 * - "We teach" and "We host" share proof from the free nights: four room
 *   photos that Home
 *   and Support do not use, and a link to each recap.
 * - "How it works" shows the three steps of a build project. Each one comes
 *   from the DSM215 record (see `steps`).
 * - "Your budget does good twice." names the local developer and the
 *   counted nights, not a general promise (see `nightsFunded`).
 * - The closing links the crew only once the crew section is published.
 *   Until then it links About ("Read our story"), not to an empty section.
 *
 * Why a rest route: a plain studio.astro always builds. This file builds
 * /studio only when getStaticPaths returns a path, which it does once
 * isStudioLive() is true. Until then /studio is a 404 in every build.
 */
export async function getStaticPaths() {
  return (await isStudioLive()) ? [{ params: { page: undefined } }] : [];
}

const studies = await getShowcase('caseStudies');
const partners = await getShowcase('partners');
const team = await getShowcase('team');

// Proof for "We teach" and "We host": Home shows room photos 1-4 and Support 5-8, so this
// row starts at 9. The recaps link under it, newest first.
const teachPhotos = await getRoomPhotos(4, 8);
const recaps = (await getCollection('events')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// How a build project runs, from the first client's record (DSM215,
// confirmed by Waskar 10/18/2026). Parts approved in writing: the agreement,
// quoted in the 10/02/2026 sign-off email. The walkthrough where the client
// made their own edit, and the handbook with numbered steps and screenshots:
// the same email.
//
// After launch (Waskar, 10/18/2026): maintenance is standard, and teaching a
// team to full ownership is an option for clients who want it. The 30-day
// warranty was DSM215's contract and is not standard yet, so the page does
// not promise one.
const steps = [
  {
    title: 'We listen.',
    line: 'We start with what your team needs and who will run it after we leave.',
  },
  {
    title: 'We build.',
    line: 'We build in parts. You approve each part in writing before we call it done.',
  },
  {
    title: 'We hand it over.',
    line: 'Your team makes its own edits in a walkthrough with us. You keep a handbook with every step and a screenshot of where to click.',
  },
];

// "Your budget does good twice." Every claim comes from the record (Waskar
// chose this copy 10/18/2026). "We hire from our community": the first build
// paid a builder from the community. It reports what happened; it is not a
// promise for every project. Unnamed until that builder agrees to be named;
// never say the split. The nights: the sum of each live case study's counted nightsFunded,
// so this line and the case study cards always agree.
const nightsFunded = studies.reduce((sum, study) => sum + (study.data.nightsFunded ?? 0), 0);
const numberWords = [
  'zero',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
];
const nightsLine =
  nightsFunded > 0
    ? `What's left pays for free build nights, about ${numberWords[nightsFunded] ?? nightsFunded} so far.`
    : "What's left pays for free build nights.";

const offers = [
  {
    kind: 'We build',
    title: 'Sites and tools you run yourself.',
    line: 'Websites, apps and intake forms for Philly nonprofits and community orgs. We train your team before we hand over the keys.',
    fill: 'bg-white',
  },
  {
    kind: 'We teach',
    title: 'Workshops where people build.',
    line: 'Hands-on sessions for your staff, members or students. Everyone leaves with something they made, not just slides.',
    fill: 'bg-brand-yellow',
  },
  {
    kind: 'We host',
    title: 'Events where guests make something.',
    line: 'Build nights and activations for your conference, launch or community. Your guests make something together, not just swap cards.',
    fill: 'bg-brand-purple',
  },
];
---

<BaseLayout
  title="Studio — Built with you, run by you"
  description="PhilaCon Valley builds sites and tools that Philly nonprofits run themselves, and teaches hands-on workshops, and hosts events where guests build. Every project pays for free build nights."
>
  <!-- Hero: the promise first. The fear it answers: being stuck with a site
       nobody can update. -->
  <section class="bg-brand-purple">
    <div class="container-custom py-[clamp(56px,8vw,112px)] flex flex-wrap gap-10 items-end justify-between">
      <div class="grow shrink basis-[640px] min-w-0 flex flex-col gap-7">
        <p class="m-0 self-start pill font-black text-[13px] tracking-[0.16em]">PhilaCon Studio</p>
        <h1 class="m-0 [text-wrap:balance]">Built with you. Run by you.</h1>
        <p class="m-0 max-w-[620px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
          We design and build for Philly nonprofits and community orgs. When we hand it over, your
          team knows how to run it.
        </p>
      </div>
      <div class="flex flex-wrap gap-3.5">
        <Button href="/contact" variant="primary" size="lg" data-testid="studio-cta">
          Start a project
        </Button>
        {studies.length > 0 && (
          <Button href="#work" variant="light" size="lg">
            See the work
          </Button>
        )}
      </div>
    </div>
  </section>

  {/* The proof: each client the way a buyer needs to see them. */}
  {studies.length > 0 && (
    <section id="work" class="bg-white border-t-2 border-brand-dark">
      <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-12">
        <div class="flex flex-col gap-[22px] max-w-[760px]">
          <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">The work</p>
          <h2 class="m-0 heading-quiet [text-wrap:balance]">Don't take our word for it.</h2>
        </div>
        <div class="flex flex-col gap-10">
          {studies.map((study) => (
            <StudioProof study={study} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- The two offers, one line each. -->
  <section class="bg-brand-coral border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-12">
      <div class="flex flex-col gap-[22px] max-w-[760px]">
        <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">What we do</p>
        <h2 class="m-0 heading-quiet [text-wrap:balance]">Three ways to work with us.</h2>
      </div>
      <ul class="m-0 p-0 list-none grid gap-7 grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))]">
        {offers.map((offer) => (
          <li
            class:list={[
              'rounded-[28px] border-2 border-brand-dark p-[clamp(28px,4vw,48px)] flex flex-col gap-5 shadow-[8px_8px_0_theme(colors.brand.dark)]',
              offer.fill,
            ]}
          >
            <span class="self-start rounded-full border-2 border-brand-dark bg-white px-3 py-[3px] font-black text-xs tracking-[0.14em] uppercase">
              {offer.kind}
            </span>
            <h3 class="m-0 text-[clamp(28px,2.6vw,38px)] leading-[0.95] [text-wrap:balance]">
              {offer.title}
            </h3>
            <p class="m-0 text-[18px] leading-[1.55]">{offer.line}</p>
          </li>
        ))}
      </ul>
      {teachPhotos.length > 0 && (
        <div class="flex flex-col gap-7" data-testid="studio-teach-proof">
          <div class="flex flex-wrap justify-between items-end gap-6">
            <p class="m-0 max-w-[620px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
              Our free build nights are where we practice teaching and hosting. These photos are
              from the room.
            </p>
            {recaps.length > 0 && (
              <ul class="m-0 p-0 list-none flex flex-wrap gap-x-6 gap-y-2">
                {recaps.map((recap) => (
                  <li>
                    <a
                      href={`/events/${recap.id}`}
                      class="inline-flex items-center min-h-11 font-black text-[17px] text-brand-dark underline underline-offset-[6px] decoration-[3px]"
                    >
                      {recap.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <PhotoGrid photos={teachPhotos} />
        </div>
      )}
    </div>
  </section>

  {partners.length > 0 && (
    <section class="bg-white border-t-2 border-brand-dark">
      <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-12">
        <div class="flex flex-col gap-[22px] max-w-[760px]">
          <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">Who we build with</p>
          <h2 class="m-0 heading-quiet">Our partners.</h2>
        </div>
        <PartnerStrip partners={partners} />
      </div>
    </section>
  )}

  <!-- How it works: the promise "run by you" in three steps. The last step
       is the proof of the promise, so it gets the pink fill. -->
  <section class="bg-brand-dark text-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-12">
      <div class="flex flex-col gap-[22px] max-w-[760px]">
        <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">How a build works</p>
        <h2 class="m-0 heading-quiet [text-wrap:balance]">
          Three steps. Then it's <span class="text-brand-yellow">yours.</span>
        </h2>
      </div>
      <ol
        class="m-0 p-0 list-none grid gap-6 grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))]"
        data-testid="studio-steps"
      >
        {steps.map((step, i) => (
          <li
            class:list={[
              'rounded-[28px] border-2 border-brand-dark p-[clamp(24px,3vw,36px)] flex flex-col gap-4 text-brand-dark',
              i === steps.length - 1 ? 'bg-brand-pink' : 'bg-white',
            ]}
          >
            <span class="font-display font-extrabold text-[32px] leading-none" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="m-0 text-[clamp(26px,2.4vw,34px)] leading-none">{step.title}</h3>
            <p class="m-0 text-[17px] leading-[1.55]">{step.line}</p>
          </li>
        ))}
      </ol>
      <p
        class="m-0 max-w-[760px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold"
        data-testid="studio-after-launch"
      >
        <span class="text-brand-yellow">After launch, you choose.</span> We keep your site
        maintained for you, or we teach your team to own all of it.
      </p>
    </div>
  </section>

  <!-- Why it matters: the one thing no other studio can say. -->
  <section class="bg-brand-yellow border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-7">
      <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">Why it matters</p>
      <h2 class="m-0 max-w-[900px] [text-wrap:balance]">Your budget does good twice.</h2>
      <p
        class="m-0 max-w-[680px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold"
        data-testid="studio-does-good"
      >
        You hire us. We hire from our community. {nightsLine}
      </p>
    </div>
  </section>

  <ClosingFlock
    lede="Tell us what you need. We'll tell you straight if we're the right fit."
    primary={{ href: '/contact', label: 'Start a project' }}
    secondary={
      team.length > 0
        ? { href: '/about#crew', label: 'Meet the crew' }
        : { href: '/about', label: 'Read our story' }
    }
  >
    Let's build it together.
  </ClosingFlock>
</BaseLayout>
