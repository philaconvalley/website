---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ClosingFlock from '../components/ClosingFlock.astro';
import EventBar from '../components/EventBar.astro';
import { getCommunityData, formatEventDate } from '../lib/community';
import { community, links } from '../config';
import { getCollection } from 'astro:content';

const { nextEvent, nightsHeld, thingsShipped } = await getCommunityData();

/**
 * Home, Edition 1.2 (DESIGN.md, "The 1.2 redesign"). Sections follow the
 * redesign mockup with three changes:
 * - The Lab timeline (LabTrack) moved to Events. On Home, with no context,
 *   "One night. Three hours." read as a one-night event (Diego, 10/15/2026).
 * - The hero line says what happens here, not only who it is for.
 * - No eyebrow labels and no 01/02/03 numbers: headings carry each section.
 *
 * Every claim is confirmed (DESIGN.md, evidence contract). The hero photo is a
 * real PATCH 003 photo; the next-event section renders only for a real event.
 */
const tagline =
  'A free tech community in Philadelphia. Every month we meet in person to build real projects together, and no one needs to feel ready first.';

// Every hero-eligible gallery photo. The HTML ships the newest one (no-JS and
// search see a real photo); a small script picks one at random per visit, so
// returning visitors see more of the room (decided 10/15/2026). No timed
// rotation: that would be a second loop (DESIGN.md, motion rule 1) and would
// need a pause control (WCAG 2.2.2).
const heroPhotos = (await getCollection('gallery'))
  .filter((entry) => entry.data.heroEligible)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({ id: entry.id, src: entry.data.image, alt: entry.data.alt }))
  // DESIGN.md names the projection wall as the hero; it leads the list, so it
  // is the photo no-JS visitors and search engines see.
  .sort(
    (a, b) =>
      Number(b.id === 'patch-003-projection-wall') - Number(a.id === 'patch-003-projection-wall'),
  )
  .map(({ src, alt }) => ({
    src,
    alt,
    // 800px copies sit beside each original (src/content/gallery images).
    srcset: `${src.replace(/\.jpg$/, '-800.jpg')} 800w, ${src} 1600w`,
  }));
const photo = heroPhotos[0];

const programs = [
  {
    name: 'PATCH',
    kind: 'Workshop Lab',
    body: 'Multi-disciplinary nights where design, code, and creative tech share a room. Recent PATCHes covered NFC tags and projection mapping.',
    fill: 'bg-brand-yellow',
  },
  {
    name: 'Lab',
    kind: 'Single topic',
    body: 'One subject, one night, start to finish. You show up curious and leave having shipped something.',
    fill: 'bg-white',
  },
];

const waysIn = [
  {
    title: 'Come to a night.',
    body: "RSVP on Luma, bring a laptop if you have one, and walk in. That's it.",
    cta: 'See events',
    href: '/events',
    external: false,
    fill: 'bg-white',
  },
  {
    title: 'Join the Discord.',
    body: "The flock lives there between events. Ask questions, share what you're building, find your people.",
    cta: 'Join the community',
    href: links.discord,
    external: true,
    fill: 'bg-white',
  },
  {
    title: 'Ship your first PR.',
    body: 'Everything we build is open source. Pick an issue on one of our projects and make your first contribution.',
    cta: 'Browse projects',
    href: '/projects',
    external: false,
    fill: 'bg-white',
  },
  {
    title: 'Bring us a project.',
    body: 'We build design, apps, and software for Philly nonprofits and community orgs. The fees keep every program free.',
    cta: 'Start a project',
    href: '/contact',
    external: false,
    fill: 'bg-brand-coral',
  },
];

const stats = [
  { value: community.memberCount, label: 'people.', note: 'Not users.' },
  {
    value: nightsHeld,
    label: nightsHeld === 1 ? 'night held.' : 'nights held.',
    note: 'All of them free.',
  },
  {
    value: thingsShipped,
    label: thingsShipped === 1 ? 'thing shipped.' : 'things shipped.',
    note: 'So far.',
  },
];
---

<BaseLayout title="PhilaCon Valley — Come as you are. Leave with a flock." description={tagline}>
  <!-- BaseLayout already wraps the page slot in <main id="main-content">. -->

  <!-- Hero: Golden Yellow (DESIGN.md, hero table). -->
  <section class="bg-brand-yellow">
    <div class="container-custom pt-16 pb-20 lg:pt-24 lg:pb-28 grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center">
      <div>
        <ul class="flex flex-wrap gap-2 m-0 p-0 list-none" aria-label="At a glance">
          <li class="pill bg-brand-pink">Philadelphia</li>
          <li class="pill bg-white">Free</li>
          <li class="pill bg-white">In person</li>
          <li class="pill bg-white">Open to everyone</li>
        </ul>
        <h1 class="mt-6 mb-0">
          <span class="block pcv-enter-word [animation-delay:0.1s]">Come as you are.</span>
          <span class="block pcv-enter-word [animation-delay:0.3s]">
            Leave with a <span class="sticker bg-white">flock.</span>
          </span>
        </h1>
        <p
          data-testid="hero-tagline"
          class="mt-7 mb-0 max-w-[34rem] text-lg lg:text-xl font-semibold pcv-enter-rise [animation-delay:0.5s]"
        >
          {tagline}
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button
            href={nextEvent?.url ?? links.luma}
            external
            variant="primary"
            size="lg"
            data-testid="home-rsvp"
          >
            RSVP for the next night
          </Button>
          <Button href={links.discord} external variant="light" size="lg">
            Join the community
          </Button>
        </div>
      </div>

      {photo && (
        <figure class="relative m-0" data-hero-photos={JSON.stringify(heroPhotos)}>
          <img
            src={photo.src}
            srcset={photo.srcset}
            sizes="(min-width: 1024px) 40vw, 100vw"
            alt={photo.alt}
            fetchpriority="high"
            width="1600"
            height="1067"
            class="block w-full h-auto aspect-[4/3] object-cover rounded-retro border-2 border-brand-dark shadow-retro-xl"
          />
          <span class="sticker bg-brand-pink absolute -top-4 -right-2 lg:-right-4 rotate-[4deg] text-lg lg:text-2xl">
            Free. Forever.
          </span>
        </figure>
      )}
    </div>
  </section>

  <!-- Why we exist -->
  <section class="bg-white border-t-2 border-brand-dark">
    <div class="container-custom py-20 lg:py-28 grid gap-8 lg:grid-cols-2 lg:gap-16 lg:items-start">
      <h2 class="m-0">Nobody handed us a way in. So we built the room.</h2>
      <div class="lg:pt-3">
        <p class="m-0 text-lg lg:text-xl leading-relaxed max-w-[38rem]">
          PhilaCon Valley is where Philly learns tech together, in the same room, at no cost. There
          is no application, no fee, and no prerequisite. You don't need to know how to code, and
          you don't need to feel ready. You just need to be curious enough to walk in.
        </p>
        <div class="mt-8">
          <Button href="/about" variant="light">
            Read our story
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- What happens here: ink takes the slot the Lab timeline held, so the page
       keeps the White -> Ink -> saturated rhythm (DESIGN.md, "Color rhythm"). -->
  <section class="bg-brand-dark text-white border-t-2 border-brand-dark">
    <div class="container-custom py-20 lg:py-28">
      <h2 class="m-0 max-w-[16ch]">Different nights. Same open door.</h2>
      <p class="mt-6 mb-0 text-lg lg:text-xl max-w-[38rem]">
        Every program is free. Labs, workshops, and career sessions, with nothing to apply for.
      </p>
      <ul class="mt-12 grid gap-6 md:grid-cols-3 m-0 p-0 list-none">
        {programs.map((program) => (
          <li
            class={`rounded-retro border-2 border-brand-dark shadow-retro-lg ${program.fill} text-brand-dark p-7 flex flex-col`}
          >
            <span class="pill bg-white self-start">{program.kind}</span>
            <h3 class="mt-5 mb-3">{program.name}</h3>
            <p class="m-0 text-base leading-relaxed flex-1">{program.body}</p>
            <p class="mt-6 mb-0 font-display font-extrabold">Free · No experience needed</p>
          </li>
        ))}
        <!-- Not a card: nothing to click yet. Outlined, no fill, no shadow. -->
        <li class="rounded-retro border-2 border-dashed border-white p-7 flex flex-col">
          <span class="pill bg-brand-dark text-white border-white self-start">Coming soon</span>
          <h3 class="mt-5 mb-3">Career support</h3>
          <p class="m-0 text-base leading-relaxed">
            Sessions for the next step after your first project. We'll share more once the first one
            is on the calendar.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Four ways in -->
  <section class="bg-brand-yellow border-t-2 border-brand-dark">
    <div class="container-custom py-20 lg:py-28">
      <h2 class="m-0 max-w-[18ch]">Four ways in. Pick one tonight.</h2>
      <p class="mt-6 mb-0 text-lg lg:text-xl max-w-[38rem]">
        You don't have to do all of them. Most people start by showing up once and figure out the
        rest from there.
      </p>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 m-0 p-0 list-none">
        {waysIn.map((way) => (
          <li
            class={`rounded-retro border-2 border-brand-dark shadow-retro-lg ${way.fill} p-7 flex flex-col`}
          >
            <h3 class="m-0">{way.title}</h3>
            <p class="mt-3 mb-0 text-base leading-relaxed flex-1">{way.body}</p>
            <div class="mt-6">
              <Button
                href={way.href}
                external={way.external}
                variant={way.fill === 'bg-white' ? 'primary' : 'light'}
              >
                {way.cta}
              </Button>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The live numbers (evidence rung 2: build-time real data). -->
  <section
    class="bg-brand-pink border-t-2 border-brand-dark"
    aria-label="PhilaCon Valley in numbers"
  >
    <dl class="container-custom py-16 lg:py-20 grid gap-10 sm:grid-cols-3 my-0">
      {stats.map((stat) => (
        <div class="pcv-enter-stat">
          <dt class="sr-only">{stat.label}</dt>
          <dd class="m-0">
            <!-- The HTML holds the real number (no-JS, search, screen readers).
                   The visible copy counts up once on scroll; the sr-only copy
                   is what assistive tech reads, so it never hears the count. -->
            <span
              aria-hidden="true"
              data-count={stat.value}
              class="block font-display font-extrabold text-[4.5rem] lg:text-[6rem] leading-[0.9] tracking-[-0.03em] tabular-nums"
            >
              {stat.value}
            </span>
            <span class="sr-only">{stat.value}</span>
            <span class="block mt-3 font-display font-extrabold text-xl lg:text-2xl">
              {stat.label}
            </span>
            <span class="block text-lg font-semibold">{stat.note}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Next up: only for a real scheduled event, never a placeholder. -->
  {nextEvent && (
    <section class="bg-white border-t-2 border-brand-dark" data-pcv-event-start={nextEvent.start}>
      <div class="container-custom py-20 lg:py-28">
        <div class="rounded-retro border-2 border-brand-dark bg-brand-dark text-white p-8 lg:p-14 shadow-retro-xl grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <h2 class="m-0">
              <span class="text-brand-yellow">Next up:</span> {nextEvent.title}
            </h2>
            <p class="mt-5 mb-0 font-mono text-sm uppercase tracking-[0.12em]">
              {formatEventDate(nextEvent.start)}
              {nextEvent.venue && ` · ${nextEvent.venue}`}
            </p>
          </div>
          <div class="flex flex-wrap gap-4">
            <Button href={nextEvent.url} external variant="secondary" size="lg">
              RSVP on Luma
            </Button>
            <Button href="/events" variant="outline-light" size="lg">
              All events
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  <ClosingFlock />

  <!-- Hero photo shuffle and the number count-up (see the file). -->
  <script is:inline defer src="/js/home.js"></script>
  <EventBar event={nextEvent} />
</BaseLayout>
