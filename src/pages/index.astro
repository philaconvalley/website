---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventBar from '../components/EventBar.astro';
import LabTrack from '../components/LabTrack.astro';
import { getCommunityData } from '../lib/community';
import { community } from '../config';
import { getCollection } from 'astro:content';

const { nextEvent, nightsHeld, thingsShipped } = await getCommunityData();

/**
 * The design calls for one full-bleed photo of a Lab — warm, faces.
 * There is no stand-in for that: the banner artwork is brand illustration, not a
 * room full of people, and cropping it full-bleed would read as a placeholder.
 * So the section renders only when a real photo exists in the gallery
 * collection, and is absent rather than wrong until one is added.
 *
 * `heroEligible` gates it rather than "newest wins". The band is ~1400px wide;
 * the PATCH 002 set tops out at 768px portrait, which the /events grid can use
 * but this cannot without visible upscaling. An absent band beats a soft one.
 */
const photo = (await getCollection('gallery'))
  .filter((entry) => entry.data.heroEligible)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const stats = [
  { value: community.memberCount, label: 'people, not users' },
  { value: nightsHeld, label: nightsHeld === 1 ? 'night held' : 'nights held' },
  {
    value: thingsShipped,
    label: thingsShipped === 1 ? 'thing shipped, so far' : 'things shipped, so far',
  },
];
---

<BaseLayout title="PhilaCon Valley — Come as you are. Leave with a flock.">
  <!-- No <main> here: BaseLayout already wraps the page slot in
       <main id="main-content">, and nesting a second one is invalid HTML that
       reports two main landmarks. -->
  <div>
    <!-- Hero -->
    <section class="px-5 lg:px-[72px] pt-[76px] pb-[84px] lg:pt-[136px] lg:pb-[140px]">
      <h1
        class="font-display font-extrabold text-[44px] lg:text-[96px] leading-[1.02] lg:leading-[0.98] tracking-[-0.03em] lg:tracking-[-0.035em] m-0 max-w-[900px]"
      >
        <span class="block overflow-hidden">
          <span class="inline-block pcv-enter-word [animation-delay:0.1s]">Come as you are.</span>
        </span>
        <span class="block overflow-hidden text-accent-600">
          <span class="inline-block pcv-enter-word [animation-delay:0.35s]">
            Leave with a flock.
          </span>
        </span>
      </h1>
      <p
        data-testid="hero-tagline"
        class="text-[17px] lg:text-[22px] leading-[1.55] lg:leading-[1.5] text-brand-dark/[0.72] max-w-[560px] mt-6 lg:mt-[34px] pcv-enter-rise [animation-delay:0.6s]"
      >
        A tech community in Philly for the people who were never handed a way in. Free, in person,
        and open before you feel ready.
      </p>
    </section>

    <!-- What a Lab actually is -->
    <section
      class="px-5 lg:px-[72px] py-14 lg:py-[104px] border-t border-brand-dark/[0.11] bg-primary-50 lg:grid lg:grid-cols-2 lg:gap-24 lg:items-start"
    >
      <h2
        class="font-display font-extrabold text-[30px] lg:text-[52px] leading-[1.08] lg:leading-[1.04] tracking-[-0.02em] lg:tracking-[-0.025em] m-0 mb-9 lg:mb-0 pcv-enter-rise"
      >
        One night. Three hours. Something exists that didn't.
      </h2>
      <LabTrack outcome="Your first pull request" outcomeDetail="Reviewed, merged, and live." />
    </section>

    {
      photo && (
        <section class="border-t border-brand-dark/[0.11]">
          <img
            src={photo.data.image}
            alt={photo.data.alt}
            loading="lazy"
            class="w-full h-[300px] lg:h-[440px] object-cover block"
          />
        </section>
      )
    }

    <!-- The two halves of the org -->
    <section
      class="px-5 lg:px-[72px] py-[60px] lg:py-[104px] border-t border-brand-dark/[0.11] lg:grid lg:grid-cols-2 lg:gap-24 lg:max-w-[1000px]"
    >
      <div>
        <h3
          class="font-display font-extrabold text-[28px] lg:text-[38px] leading-[1.08] lg:leading-[1.05] tracking-[-0.02em] m-0 mb-3 lg:mb-3.5"
        >
          Free, forever, for us.
        </h3>
        <p class="text-base lg:text-[17px] leading-[1.65] text-brand-dark/70 m-0">
          Labs, workshops, and career sessions. You show up, you pair with someone, you leave having
          made a thing. No application, no fee, no prerequisite.
        </p>
        <a
          href="/join"
          class="inline-block font-display font-bold text-base mt-3.5 lg:mt-5 py-3 lg:py-0 lg:pb-0.5 text-brand-dark no-underline border-b-2 border-brand-pink hover:text-accent-700 transition-colors"
        >
          Join {community.memberCount} of us →
        </a>
      </div>
      <div class="mt-[52px] lg:mt-0">
        <h3
          class="font-display font-extrabold text-[28px] lg:text-[38px] leading-[1.08] lg:leading-[1.05] tracking-[-0.02em] m-0 mb-3 lg:mb-3.5"
        >
          Paid work that pays for it.
        </h3>
        <p class="text-base lg:text-[17px] leading-[1.65] text-brand-dark/70 m-0">
          Design, apps, and software for Philly nonprofits and community orgs. The fee funds the
          free side — and the people who build it came up through it.
        </p>
        <a
          href="/contact"
          class="inline-block font-display font-bold text-base mt-3.5 lg:mt-5 py-3 lg:py-0 lg:pb-0.5 text-brand-dark no-underline border-b-2 border-brand-pink hover:text-accent-700 transition-colors"
        >
          Start a project →
        </a>
      </div>
    </section>

    <!-- What it adds up to -->
    <section
      class="px-5 lg:px-[72px] py-14 lg:py-[84px] border-t border-brand-dark/[0.11] flex flex-col lg:flex-row gap-[30px] lg:gap-[88px] pcv-enter-stat"
    >
      {
        stats.map((stat) => (
          <div>
            <div class="font-display font-extrabold text-[60px] lg:text-[84px] leading-[0.86] lg:leading-[0.9] tracking-[-0.04em]">
              {stat.value}
            </div>
            <div class="font-mono text-[10px] lg:text-[11px] font-medium uppercase tracking-[0.18em] text-brand-dark/50 mt-2 lg:mt-3">
              {stat.label}
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <!-- Clears the fixed bottom bar so the footer's last line is never trapped under
       it. Carries the same expiry as the bar: once the bar removes itself, this
       would otherwise leave 88px of dead space at the bottom of the page. -->
  {
    nextEvent && (
      <div class="lg:hidden h-[88px]" data-pcv-event-start={nextEvent.start} aria-hidden="true" />
    )
  }
  <EventBar event={nextEvent} />
</BaseLayout>
