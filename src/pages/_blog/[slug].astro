---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import BackLink from '../../components/BackLink.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Cross-posts (externalUrl set) have no real body content — they link out from
  // blog/index.astro instead, so no internal page should exist for their slug.
  return posts
    .filter((post) => !post.data.externalUrl)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, author, date, tags } = post.data;
---

<BaseLayout title={`${title} - PhilaCon Valley Blog`} description={description}>
  <section class="bg-brand-yellow text-brand-dark py-16">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <BackLink
          href="/blog"
          label="Back to Blog"
          class="text-brand-dark/50 hover:text-brand-dark"
        />
        <h1 class="text-4xl md:text-5xl mb-4">{title}</h1>
        <p class="text-xl text-brand-dark/70 mb-6">{description}</p>
        <div class="flex items-center text-sm text-brand-dark/50">
          <span>By {author}</span>
          <span class="mx-2">·</span>
          <time>
            {date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-8 pt-8 border-t border-brand-dark/5">
            <TagList tags={tags} />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-purple text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl mb-4">Stay connected</h2>
      <p class="text-lg text-white/80 mb-6 max-w-2xl mx-auto">
        Follow us for more updates, event recaps, and community stories.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/blog" variant="primary">
          More posts
        </Button>
        <Button href="/events" variant="outline-light">
          View events
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
