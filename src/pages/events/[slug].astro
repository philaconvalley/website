---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import ClosingFlock from '../../components/ClosingFlock.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { formatRecapDate, photoSrcset } from '../../lib/events';

/**
 * An event recap, Edition 1.2 (site audit, 10/18/2026). The recaps are the
 * strongest content on the site, and this page still wore the old template: a
 * muted purple hero, small type, and every photo captioned with the event
 * title. Now:
 * - Golden Yellow hero with the night's own cover photo, the same object
 *   treatment as the Home hero (ink outline, hard shadow).
 * - The recap text on white, at reading width.
 * - Every photo with its own caption (src/content.config.ts requires one).
 * - The shared closing, with the event-aware default button: an RSVP only for
 *   a real event, "Get notified" otherwise.
 *
 * Steve Jobs review follow-ups, 10/18/2026:
 * - The cover photo is the share image, so a recap link shows the night itself.
 * - The page links the night before and the night after, so a recap is not a
 *   dead end.
 * - The photo grid leaves out the cover, so the hero photo does not repeat.
 */

export async function getStaticPaths() {
  // Oldest first, so the night before is i - 1 and the night after is i + 1.
  const recaps = (await getCollection('events')).sort(
    (a, b) => a.data.date.getTime() - b.data.date.getTime(),
  );
  const photos = await getCollection('gallery');
  const link = (recap: (typeof recaps)[number] | undefined) =>
    recap && { href: `/events/${recap.id}`, title: recap.data.title };
  return recaps.map((recap, i) => ({
    params: { slug: recap.id },
    props: {
      recap,
      before: link(recaps[i - 1]),
      after: link(recaps[i + 1]),
      // Missing event files are caught on /events, which resolves every photo.
      // Here a photo only needs to know whether it belongs to this recap.
      photos: photos
        .filter((photo) => photo.data.event.id === recap.id)
        .sort((a, b) => a.data.date.getTime() - b.data.date.getTime() || a.id.localeCompare(b.id)),
    },
  }));
}

const { recap, photos, before, after } = Astro.props;
const { Content } = await render(recap);
const { title, date, venue, lumaUrl, summary } = recap.data;

// The cover: a wide hero-eligible shot first, otherwise the first photo. The
// same rule as the recap cards on /events.
const cover = photos.find((photo) => photo.data.heroEligible) ?? photos[0];
// The grid leaves the cover out, so no photo shows twice on the page.
const rest = photos.filter((photo) => photo !== cover);
---

<BaseLayout
  title={`${title} - PhilaCon Valley Events`}
  description={summary}
  image={cover?.data.image}
  type="article"
>
  <section class="bg-brand-yellow">
    <div class="container-custom pt-10 pb-[clamp(56px,8vw,112px)] grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div class="min-w-0 flex flex-col gap-6">
        <BackLink
          href="/events"
          label="Back to Events"
          class="self-start min-h-11 font-black text-brand-dark underline underline-offset-[5px] decoration-2 !mb-0"
        />
        <p class="m-0 self-start pill bg-white">
          {formatRecapDate(date)} · {venue}
        </p>
        <h1 class="m-0 text-[clamp(2.75rem,1.6rem+4.4vw,5.5rem)] [text-wrap:balance]">{title}</h1>
        <p class="m-0 max-w-[600px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
          {summary}
        </p>
      </div>
      {cover && (
        <figure class="m-0 min-w-0">
          <img
            src={cover.data.image}
            srcset={photoSrcset(cover.data.image)}
            sizes="(min-width: 1024px) 45vw, calc(100vw - 32px)"
            width="1600"
            height="1067"
            alt={cover.data.alt}
            class="block w-full h-auto aspect-[4/3] object-cover rounded-retro border-2 border-brand-dark shadow-retro-xl"
          />
        </figure>
      )}
    </div>
  </section>

  <section class="bg-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(56px,7vw,96px)]">
      <div class="max-w-3xl prose prose-lg text-brand-dark prose-code:before:content-none prose-code:after:content-none">
        <Content />
      </div>
      {lumaUrl && (
        <a
          href={lumaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center min-h-11 font-black text-[17px] text-brand-dark underline underline-offset-[6px] decoration-[3px]"
        >
          This night on Luma
        </a>
      )}
    </div>
  </section>

  {rest.length > 0 && (
    <section class="bg-brand-yellow border-t-2 border-brand-dark">
      <div class="container-custom py-[clamp(56px,7vw,96px)] flex flex-col gap-10">
        <div class="flex flex-col gap-[22px] max-w-[760px]">
          <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">From the room</p>
          <h2 class="m-0 heading-quiet">Photos from the night.</h2>
        </div>
        <PhotoGrid
          photos={rest.map((photo) => ({
            image: photo.data.image,
            alt: photo.data.alt,
            caption: photo.data.caption,
          }))}
        />
      </div>
    </section>
  )}

  {(before || after) && (
    <nav
      aria-label="More nights"
      class="bg-white border-t-2 border-brand-dark"
      data-testid="recap-nav"
    >
      <div class="container-custom py-10 flex flex-wrap justify-between gap-6">
        {before ? (
          <a href={before.href} rel="prev" class="flex flex-col gap-1 min-h-11">
            <span class="font-black text-[13px] tracking-[0.2em] uppercase">The night before</span>
            <span class="font-display font-extrabold uppercase text-[clamp(20px,2vw,28px)] leading-none underline underline-offset-[6px] decoration-[3px]">
              {before.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {after && (
          <a href={after.href} rel="next" class="flex flex-col gap-1 min-h-11 text-right ml-auto">
            <span class="font-black text-[13px] tracking-[0.2em] uppercase">The night after</span>
            <span class="font-display font-extrabold uppercase text-[clamp(20px,2vw,28px)] leading-none underline underline-offset-[6px] decoration-[3px]">
              {after.title}
            </span>
          </a>
        )}
      </div>
    </nav>
  )}

  <ClosingFlock
    lede="Every night is free. No experience needed, and you don't have to come with anyone."
    secondary={{ href: '/events', label: 'All events' }}
  >
    Come to the next one.
  </ClosingFlock>
</BaseLayout>
