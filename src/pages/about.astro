---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FounderNote from '../components/FounderNote.astro';

/**
 * Mode: Read. Budget: 550 body words (DESIGN.md).
 *
 * This page used to say the same thing four times: an "Our story" section, a
 * founder's note, a "Who we serve" section and a "Philly, by us, for us"
 * section all made the same argument in different words, and the six values
 * arrived as icon cards — the treatment the evidence contract bans.
 *
 * The note is now the spine. It is Waskar's own account, taken from his own
 * words rather than paraphrased about him, and every section that restated it
 * is gone. The values stay, set as language instead of decorated with stock
 * glyphs, because a value nobody can read past the icon is not a value.
 *
 * Deliberately no numbers. Attendance figures are the metric the org is in the
 * middle of moving away from, and hard-coding them here would write the old
 * frame into the site on the way out of it.
 */

const values = [
  {
    name: 'Centering the margins',
    line: 'Black, Brown, LGBTQIA+, and underrepresented folks lead here. Not just attend.',
  },
  {
    name: 'Hands-on learning',
    line: 'Build sessions, not lectures. You leave with something that runs.',
  },
  {
    name: 'Community over competition',
    line: 'Nobody here is your competition. Your success is the point.',
  },
  {
    name: 'Philly pride',
    line: 'Built in Philadelphia, on purpose, by people from it.',
  },
  {
    name: 'Open knowledge',
    line: 'Every project open source. Every resource free.',
  },
  {
    name: 'Radical welcome',
    line: 'First line of code yesterday, or ten years in. Same table.',
  },
];

const programs = [
  {
    name: 'Lab',
    line: "Our flagship. Bring a project or join someone else's. No presentations, just building.",
  },
  {
    name: 'Workshops',
    line: 'Git basics through shipping an API. You do the work in the room.',
  },
  {
    name: 'Career support',
    line: 'Resume reviews, interview prep, and introductions to companies worth working for.',
  },
  {
    name: 'Community projects',
    line: 'Tools our own community uses — which makes them real portfolio work.',
  },
];
---

<BaseLayout
  title="About PhilaCon Valley - Why this exists"
  description="Philadelphia's tech community, by us, for us. Why PhilaCon Valley exists, in the founder's own words."
>
  <section class="bg-brand-coral text-white py-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">About PhilaCon Valley</h1>
        <p class="text-2xl text-white/85">
          Making Philly the tech hub it's meant to be: by us, for us.
        </p>
      </div>
    </div>
  </section>

  <!--
    The spine of the page. Waskar's words, from his own account of the
    Resilient Coders cohort ending — not a paraphrase written about him.
  -->
  <section class="section-padding bg-brand-cream">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-bold mb-8 text-center">Why this exists</h2>
        <FounderNote>
          <p>
            I finished a coding bootcamp in December 2024. Resilient Coders. On Demo Day I showed an
            app I'd built from nothing, in a room full of people who had been in it with me every
            day for months.
          </p>
          <p>
            Then it ended, and I went home, and the room was gone. Where are the friends I made?
          </p>
          <p>
            That's the whole reason this exists. Philly has no shortage of tech events — I went to
            them. You hand out a card, you listen to a talk, you go home with nobody. I didn't need
            another audience. I needed the cohort back.
          </p>
          <p>
            So I built one that doesn't graduate. We meet, we build real things, and the people
            around the table are still there next month.
          </p>
          <p>
            The name is on purpose. Silicon Valley decided who counted as a tech person. We're
            deciding that here.
          </p>
          <p>I got here late and sideways. Most of us did.</p>
        </FounderNote>
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-yellow border-t-[3px]">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-12">What we hold to</h2>
        <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8 m-0">
          {
            values.map((value) => (
              <div>
                <dt class="font-display text-2xl font-bold mb-1">{value.name}</dt>
                <dd class="m-0 text-brand-dark/70">{value.line}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-12">What we run</h2>
        <dl class="space-y-8 m-0">
          {
            programs.map((program) => (
              <div>
                <dt class="font-display text-2xl font-bold mb-1">{program.name}</dt>
                <dd class="m-0 text-lg text-brand-dark/70">{program.line}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section-padding bg-accent-400 text-brand-dark border-t-[3px]">
    <div class="container-custom text-center">
      <h2 class="text-4xl font-bold mb-6">Come build with us</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">Show up before you feel ready.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/join" variant="secondary" size="lg">Get involved</Button>
        <Button
          href="/events"
          variant="outline"
          size="lg"
          class="!text-brand-dark !border-brand-dark hover:!bg-brand-dark/10"
        >
          Attend an event
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
