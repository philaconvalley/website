---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingFlock from '../components/ClosingFlock.astro';
import { site, links } from '../config';

/**
 * Contact, Edition 1.2 (DESIGN.md, "The 1.2 redesign"). Sections follow
 * Diego's mockup, with these decisions (Waskar, 10/17/2026):
 * - The form is the same working form as before (Formspree, the res.ok check,
 *   the 15-second timeout, the spam trap); only its layout changed.
 * - "We usually reply within 24 to 48 hours." is confirmed.
 * - The FAQ uses native <details>, so it works with no JavaScript and with a
 *   keyboard. The Slack answer matches /join: a quieter backup, with the
 *   invite link.
 * - The closing uses ClosingFlock's event-aware default button: an RSVP for a
 *   real event, "Get notified" otherwise.
 */

const social = [
  { label: 'Discord', href: links.discord },
  { label: 'Instagram', href: links.social.instagram },
  { label: 'LinkedIn', href: links.social.linkedin },
  { label: 'X', href: links.social.twitter },
  { label: 'GitHub', href: links.github.org },
];

const lumaLabel = links.luma.replace(/^https?:\/\//, '');
---

<BaseLayout
  title="Contact — Say hi to PhilaCon Valley"
  description="Questions about an event, a project you want built, an idea for a workshop, or just hello. It all lands in the same inbox."
>
  <!-- Hero: Amber, as in the mockup. -->
  <section class="bg-brand-amber">
    <div class="container-custom py-[clamp(56px,8vw,112px)] flex flex-col gap-7">
      <p class="m-0 self-start pill font-black text-[13px] tracking-[0.16em]">Get in touch</p>
      <h1 class="m-0 max-w-[1000px] [text-wrap:balance]">Say hi. We'll say it back.</h1>
      <p class="m-0 max-w-[600px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
        Questions about an event, a project you want built, an idea for a workshop, or just hello.
        It all lands in the same inbox.
      </p>
    </div>
  </section>

  <!-- Let's connect, beside the form. -->
  <section class="bg-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] grid gap-7 grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="rounded-[28px] border-2 border-brand-dark bg-brand-dark text-white p-[clamp(28px,3.5vw,40px)] flex flex-col gap-6 shadow-[8px_8px_0_theme(colors.brand.pink)]">
        <h2 class="m-0 text-brand-yellow text-[clamp(32px,3vw,44px)] leading-none">
          Let's connect.
        </h2>
        <dl class="m-0 flex flex-col gap-5">
          <div class="flex flex-col gap-1">
            <dt class="font-black text-[13px] tracking-[0.14em] uppercase text-brand-yellow">
              Email
            </dt>
            <dd class="m-0">
              <a
                href={`mailto:${site.email}`}
                class="inline-flex items-center min-h-11 font-extrabold text-[18px] text-white underline underline-offset-[4px] decoration-2 break-all"
              >
                {site.email}
              </a>
            </dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="font-black text-[13px] tracking-[0.14em] uppercase text-brand-yellow">
              Location
            </dt>
            <dd class="m-0 font-black">{site.location}</dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="font-black text-[13px] tracking-[0.14em] uppercase text-brand-yellow">
              Events
            </dt>
            <dd class="m-0">
              <a
                href={links.luma}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center min-h-11 font-extrabold text-[18px] text-white underline underline-offset-[4px] decoration-2"
              >
                {lumaLabel}
              </a>
            </dd>
          </div>
        </dl>
        <div class="mt-auto flex flex-col gap-3">
          <p class="m-0 font-black text-[13px] tracking-[0.14em] uppercase text-brand-yellow">
            Find us
          </p>
          <ul class="m-0 p-0 list-none flex flex-wrap gap-2.5" data-testid="contact-social">
            {social.map((s, i) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"

                  class:list={[
                    'inline-flex items-center min-h-11 px-4 rounded-full border-2 border-brand-dark font-display font-extrabold text-sm text-brand-dark transition-[transform,background-color] duration-150 ease-out motion-safe:hover:-translate-y-0.5 motion-safe:active:scale-[0.97]',
                    i === 0 ? 'bg-brand-yellow' : 'bg-white hover:bg-brand-yellow',
                  ]}
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="rounded-[28px] border-2 border-brand-dark bg-brand-yellow p-[clamp(28px,3.5vw,40px)] flex flex-col gap-6 shadow-[8px_8px_0_theme(colors.brand.dark)]">
        <h2 class="m-0 text-[clamp(32px,3vw,44px)] leading-none">Send us a message.</h2>
        <form
          action={links.formspree}
          method="POST"
          class="flex flex-col"
          x-data="{ status: 'idle' }"
          @submit.prevent="status = 'sending'; const stop = new AbortController(); const timer = setTimeout(() => stop.abort(), 15000); fetch($el.action, { method: 'POST', body: new FormData($el), headers: { 'Accept': 'application/json' }, signal: stop.signal }).then((res) => { if (!res.ok) throw new Error(res.status); status = 'sent'; $el.reset(); }).catch(() => { status = 'error'; }).finally(() => clearTimeout(timer))"
        >
          <!--
            fetch() only rejects on a network failure. Formspree answers a rejected
            submission (spam filter, bad form ID, quota) with a 4xx, which still
            resolves. Without the res.ok check, those showed "Message sent!" and the
            message was lost. The 15-second abort covers the other silent failure: a
            request that never answers, which left the button on "Sending..." forever.
          -->
          <div x-show="status !== 'sent'" class="grid gap-5 grid-cols-1 sm:grid-cols-2">
            <!--
              Spam trap. Formspree drops any submission that fills `_gotcha`. People
              never see the field; bots that fill every input do.
            -->
            <input
              type="text"
              name="_gotcha"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <div>
              <label
                for="name"
                class="block mb-2 font-black text-[13px] tracking-[0.14em] uppercase text-brand-dark"
              >
                Name *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                class="w-full px-4 py-3 border-2 border-brand-dark rounded-[14px] bg-white"
                placeholder="Your name"
              />
            </div>

            <div>
              <label
                for="email"
                class="block mb-2 font-black text-[13px] tracking-[0.14em] uppercase text-brand-dark"
              >
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                class="w-full px-4 py-3 border-2 border-brand-dark rounded-[14px] bg-white"
                placeholder="you@example.com"
              />
            </div>

            <div class="sm:col-span-2">
              <label
                for="subject"
                class="block mb-2 font-black text-[13px] tracking-[0.14em] uppercase text-brand-dark"
              >
                Subject
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="w-full px-4 py-3 border-2 border-brand-dark rounded-[14px] bg-white"
                placeholder="Event question, project idea, sponsorship..."
              />
            </div>

            <div class="sm:col-span-2">
              <label
                for="message"
                class="block mb-2 font-black text-[13px] tracking-[0.14em] uppercase text-brand-dark"
              >
                Message *
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 border-2 border-brand-dark rounded-[14px] bg-white resize-none"
                placeholder="What's on your mind?"
              ></textarea>
            </div>

            <div
              x-show="status === 'error'"
              x-cloak
              role="alert"
              class="sm:col-span-2 bg-white border-2 border-brand-dark rounded-[14px] p-4 text-brand-dark"
            >
              <p class="font-semibold">Your message did not send.</p>
              <p class="text-sm mt-1">
                Your text is still here. Try again, or email us at{' '}
                <a href={`mailto:${site.email}`} class="underline font-semibold">
                  {site.email}
                </a>
                .
              </p>
            </div>

            <div class="sm:col-span-2 flex flex-wrap items-center justify-between gap-4">
              <!-- Same classes as a large primary Button (src/components/Button.astro).
                   It is a raw <button> because Alpine binds :disabled to it. -->
              <button
                type="submit"
                :disabled="status === 'sending'"
                class="disabled:opacity-60 disabled:cursor-wait w-full sm:w-auto inline-flex items-center justify-center min-h-[55px] px-7 py-2.5 border-2 border-brand-dark bg-brand-pink text-brand-dark font-display font-extrabold text-[17px] rounded-full lift"
              >
                <span x-text="status === 'sending' ? 'Sending...' : 'Send message'">
                  Send message
                </span>
              </button>
              <p class="m-0 font-bold text-[15px]">We usually reply within 24 to 48 hours.</p>
            </div>
          </div>

          <!-- Success Message -->
          <div
            x-show="status === 'sent'"
            x-cloak
            role="status"
            class="bg-green-50 border border-green-200 rounded-lg p-6 text-center"
          >
            <svg
              class="w-12 h-12 text-green-600 mx-auto mb-3"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <h3 class="text-xl text-green-900 mb-2">Message sent!</h3>
            <p class="text-green-700">
              Thanks for reaching out. We'll get back to you as soon as possible!
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Before you ask: native disclosures, the first one open. -->
  <section class="bg-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] grid gap-10 grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="flex flex-col gap-[22px]">
        <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">Common questions</p>
        <h2 class="m-0 [text-wrap:balance]">Before you ask.</h2>
      </div>
      <div class="flex flex-col gap-3.5" data-testid="faq">
        <details
          open
          class="group rounded-[20px] border-2 border-brand-dark bg-white open:bg-brand-yellow"
        >
          <summary class="faq-summary">Do events cost anything?</summary>
          <p class="m-0 px-5 pb-5 text-[17px] leading-[1.55]">
            No. Every event is free, and it's going to stay that way.
          </p>
        </details>
        <details class="group rounded-[20px] border-2 border-brand-dark bg-white open:bg-brand-yellow">
          <summary class="faq-summary">I'm a total beginner. Can I come?</summary>
          <p class="m-0 px-5 pb-5 text-[17px] leading-[1.55]">
            Yes. No experience is needed, and every level is in the room, so there's always someone
            who's been where you are.
          </p>
        </details>
        <details class="group rounded-[20px] border-2 border-brand-dark bg-white open:bg-brand-yellow">
          <summary class="faq-summary">How do I join the Discord?</summary>
          <p class="m-0 px-5 pb-5 text-[17px] leading-[1.55]">
            Use the invite on our{' '}
            <a href="/join" class="font-black underline underline-offset-[4px] decoration-2">
              Join page
            </a>
            . You join as a Neighbor, and the flock takes it from there.
          </p>
        </details>
        <details class="group rounded-[20px] border-2 border-brand-dark bg-white open:bg-brand-yellow">
          <summary class="faq-summary">Is there a Slack?</summary>
          <p class="m-0 px-5 pb-5 text-[17px] leading-[1.55]">
            Yes, as a backup for people who can't reach Discord. It's quieter than Discord, but it's
            real.{' '}
            <a
              href={links.slack}
              target="_blank"
              rel="noopener noreferrer"
              class="font-black underline underline-offset-[4px] decoration-2"
            >
              Join our Slack
            </a>
            .
          </p>
        </details>
        <details class="group rounded-[20px] border-2 border-brand-dark bg-white open:bg-brand-yellow">
          <summary class="faq-summary">Can I lead a workshop or write a guide?</summary>
          <p class="m-0 px-5 pb-5 text-[17px] leading-[1.55]">
            Yes. Send us your workshop idea with the form above. For a guide, follow{' '}
            <a
              href={`${links.github.website}/blob/main/docs/adding-content.md#adding-a-resource`}
              target="_blank"
              rel="noopener noreferrer"
              class="font-black underline underline-offset-[4px] decoration-2"
            >
              the contribution guide
            </a>
            .
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- The Contact closing, in the mockup's headline, with the event-aware
       default main button. The motto is Home's alone (site audit, 10/18/2026). -->
  <ClosingFlock
    lede="Every night is free and open. Come say hi, and bring your question with you."
    secondary={{ href: '/join', label: 'Join the community' }}
  >
    Or just come say it in person.
  </ClosingFlock>
</BaseLayout>
