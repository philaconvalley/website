---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ClosingFlock from '../../components/ClosingFlock.astro';
import FirstPrSteps from '../../components/FirstPrSteps.astro';
import { getProjects } from '../../lib/projects';
import { links } from '../../config';

/**
 * Projects, Edition 1.2 (DESIGN.md, "The 1.2 redesign"). Sections follow
 * Diego's mockup, with these decisions (Waskar, 10/16/2026):
 * - The hero says "Every community project is open source." The mockup said
 *   "Everything we make", but client work lives in private repos.
 * - The repo list and count come live from the GitHub org at build time
 *   (src/lib/projects.ts), with a saved copy if GitHub does not answer. Card
 *   copy comes from src/data/projects.ts; a new repo shows its GitHub
 *   description until someone adds copy for it.
 * - Each card shows its open "good first issue" count. A filled card means
 *   "ready for a newcomer": repos with good first issues take Golden Yellow,
 *   Hot Pink and ink in turn; the rest are white. Ready repos come first.
 */

const projects = await getProjects();

// The heading spells out small counts, as the mockup does ("Nine things
// shipped"). The count is the cards on this page, so the two always agree.
const words = [
  'Zero',
  'One',
  'Two',
  'Three',
  'Four',
  'Five',
  'Six',
  'Seven',
  'Eight',
  'Nine',
  'Ten',
  'Eleven',
  'Twelve',
];
const count = words[projects.length] ?? String(projects.length);
const shipped = `${count} ${projects.length === 1 ? 'thing' : 'things'} shipped.`;

const fills = [
  'bg-brand-yellow text-brand-dark',
  'bg-brand-pink text-brand-dark',
  'bg-brand-dark text-white',
];
// The first tag follows the mockup: an accent on white cards (in turn), white
// on yellow and pink cards, and Golden Yellow on the ink card. Pills keep ink
// text, which reads on every one of these fills.
const accents = ['bg-brand-pink', 'bg-brand-amber', 'bg-brand-yellow', 'bg-brand-coral'];
let ready = 0;
let plain = 0;
const cards = projects.map((project) => {
  const fill = project.goodFirstIssues > 0 ? fills[ready++ % fills.length] : 'bg-white';
  const ink = fill.includes('bg-brand-dark');
  const firstTag =
    fill === 'bg-white' ? accents[plain++ % accents.length] : ink ? 'bg-brand-yellow' : 'bg-white';
  return { ...project, fill, ink, firstTag };
});

const issuesUrl = (repoUrl: string) =>
  `${repoUrl}/issues?q=${encodeURIComponent('is:issue is:open label:"good first issue"')}`;
// GitHub's /issues page needs a login (logged-out visitors get a 404), so the
// org-wide link uses the public search page instead.
const allIssuesUrl = `https://github.com/search?type=issues&q=${encodeURIComponent(
  'org:philaconvalley label:"good first issue" is:issue is:open',
)}`;
---

<BaseLayout
  title="Projects — Open-source community projects from Philadelphia | PhilaCon Valley"
  description="Every PhilaCon Valley community project is open source. Browse the repos, pick a good first issue, and open your first pull request."
>
  <!-- Hero: Amber, as in the mockup. -->
  <section class="bg-brand-amber">
    <div class="container-custom py-[clamp(56px,8vw,112px)] flex flex-wrap gap-10 items-end justify-between">
      <div class="grow shrink basis-[640px] min-w-0 flex flex-col gap-7">
        <p class="m-0 self-start pill font-black text-[13px] tracking-[0.16em]">
          Community projects
        </p>
        <h1 class="m-0">Built by the flock. For the flock.</h1>
        <p class="m-0 max-w-[600px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
          Every community project is open source. Browse the repos, pick an issue, and open your
          first pull request.
        </p>
      </div>
      <div class="flex flex-wrap gap-3.5">
        <Button href={links.github.org} external variant="primary" size="lg">
          View on GitHub
        </Button>
        <Button href="#first-pr" variant="light" size="lg">
          Make your first PR
        </Button>
      </div>
    </div>
  </section>

  <!-- The repos: one card per public org repo, newcomer-ready first. -->
  <section class="bg-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,128px)] flex flex-col gap-14">
      <div class="flex flex-col gap-[22px] max-w-[760px]">
        <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">The repos</p>
        <h2 class="m-0 [text-wrap:balance]" data-testid="projects-count">
          {shipped} So far.
        </h2>
      </div>
      <ul
        class="m-0 p-0 list-none grid gap-6 grid-cols-[repeat(auto-fill,minmax(min(250px,100%),1fr))]"
        data-testid="project-cards"
      >
        {cards.map((card) => (
          <li
            class:list={[
              'rounded-[24px] border-2 border-brand-dark p-6 flex flex-col gap-3',
              card.fill,
              card.ink
                ? 'shadow-[6px_6px_0_theme(colors.brand.pink)]'
                : 'shadow-[6px_6px_0_theme(colors.brand.dark)]',
            ]}
            data-testid="project-card"
            data-ready={card.goodFirstIssues > 0 ? 'true' : 'false'}
          >
            <p
              class:list={[
                // 500 is the heaviest JetBrains Mono weight the site ships (BaseLayout);
                // the mockup's 700 would be a faked bold.
                'm-0 font-mono text-[13px] font-medium [overflow-wrap:anywhere]',
                card.ink ? 'text-brand-yellow' : 'text-brand-dark',
              ]}
            >
              philaconvalley/
              <wbr />
              {card.name}
            </p>
            <h3 class="m-0 normal-case text-[28px] leading-[1.05] break-words">
              <a
                href={card.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center min-h-11 underline decoration-2 underline-offset-4 decoration-transparent hover:decoration-current focus-visible:decoration-current"
              >
                {card.title}
              </a>
            </h3>
            <p class="m-0 text-[15px] leading-[1.55]">{card.blurb}</p>
            <div class="mt-auto pt-2 flex flex-col gap-3">
              {card.tags.length > 0 && (
                <ul class="m-0 p-0 list-none flex flex-wrap gap-2" aria-label="Tags">
                  {card.tags.map((tag, i) => (
                    <li
                      class:list={[
                        'pill normal-case tracking-normal text-xs',
                        i === 0 && card.firstTag,
                      ]}
                    >
                      {tag}
                    </li>
                  ))}
                </ul>
              )}
              {card.goodFirstIssues > 0 && (
                <a
                  href={issuesUrl(card.url)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'self-start inline-flex items-center min-h-11 font-black text-sm underline underline-offset-4 decoration-2',
                    card.ink ? 'text-brand-yellow' : 'text-brand-dark',
                  ]}
                  data-testid="good-first-issues"
                >
                  {card.goodFirstIssues} good first{' '}
                  {card.goodFirstIssues === 1 ? 'issue' : 'issues'}
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- New to open source: ink, as in the mockup. The six-step walkthrough sits
       right below it (site audit, 10/18/2026: it moved here from /join). -->
  <section class="bg-brand-dark text-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-wrap gap-10 items-center justify-between">
      <div class="grow shrink basis-[560px] min-w-0 flex flex-col gap-6">
        <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">New to open source?</p>
        <h2 class="m-0 text-white">
          Look for the <span class="text-brand-yellow">good first issue</span> label.
        </h2>
        <p class="m-0 max-w-[560px] text-[clamp(17px,1.4vw,19px)] leading-[1.55]">
          Those issues are picked for first-timers. Our six-step walkthrough gets you from fork to
          pull request.
        </p>
      </div>
      <div class="flex flex-wrap gap-3.5">
        <Button href="#first-pr" variant="secondary" size="lg">
          Follow the walkthrough
        </Button>
        <Button href={allIssuesUrl} external variant="outline-light" size="lg">
          Browse open issues
        </Button>
      </div>
    </div>
  </section>

  <FirstPrSteps />

  <!-- The Projects closing, in the mockup's copy. -->
  <ClosingFlock
    lede="Made it at one of our nights or on your own? Send it our way and we'll show it off."
    primary={{ href: '/contact', label: 'Submit your project' }}
    secondary={{ href: links.github.org, label: 'View on GitHub', external: true }}
  >
    Built something cool?
  </ClosingFlock>
</BaseLayout>
