---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import FirstPRWalkthrough from '../components/FirstPRWalkthrough.astro';
import { links } from '../config';
import { getCommunityData } from '../lib/community';

/**
 * Mode: Persuade. Budget: 250 body words (DESIGN.md).
 *
 * This page used to make its case in six stock-icon cards, six checkmark
 * bullets and a five-item values list — the treatment the evidence contract
 * bans, because it decorates the spot where proof belongs. The proof here is
 * the walkthrough: the visitor opens a real pull request rather than reading
 * that we help people open them.
 */

const { discord } = await getCommunityData();

/**
 * Discord is the front door — one decision, no cost. The Lab and the Open
 * Collective ask are a different kind of decision entirely, so they no
 * longer share a three-item list with equal visual weight. They stay here
 * as a secondary row because they are still real ways in, just not the
 * first one.
 */
const secondaryRoutes = [
  {
    label: 'Come to a Lab',
    detail: 'Free, in person, no experience assumed.',
    href: links.luma,
    cta: 'See the next one',
    external: true,
  },
  {
    label: 'Keep it free',
    detail: 'Open Collective covers the room and the hardware.',
    href: '/support',
    cta: 'Chip in',
    external: false,
  },
];
---

<BaseLayout
  title="Join PhilaCon Valley - Get involved"
  description="Show up before you feel ready. Open your first pull request, come to a Lab, or get on Discord."
>
  <section class="bg-accent-400 text-white py-20">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Join the community</h1>
        <p class="text-2xl text-white/85 mb-10">Show up before you feel ready.</p>

        <!-- The front door. One decision, no cost, shown rather than described:
             a visitor sees the real server — its name, icon, and who's already
             in it — before being asked to click into it blind. -->
        <div
          class="bg-white text-brand-dark rounded-retro p-6 md:p-8 shadow-retro border-2 border-brand-dark/10 text-left max-w-md mx-auto"
        >
          <div class="flex items-center gap-4">
            {
              discord.iconUrl && (
                <img
                  src={discord.iconUrl}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  class="w-14 h-14 rounded-full flex-shrink-0"
                />
              )
            }
            <div>
              <p class="font-display font-bold text-lg leading-tight m-0">{discord.name}</p>
              <p class="text-sm text-brand-dark/60 m-0">
                {discord.memberCount} members · {discord.onlineCount} online now
              </p>
            </div>
          </div>
          <Button href={links.discord} external variant="primary" size="lg" class="w-full mt-6">
            Join the Discord →
          </Button>
          <p class="text-xs text-brand-dark/50 mt-3 mb-0 text-center">
            Discord's blocked in some countries — email us for a Slack invite if that's you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The proof. Rung 1: you operate it, you do not read about it. -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-bold mb-4">Your first pull request</h2>
        <p class="text-lg text-brand-dark/70 mb-8">
          Six steps, on this site's own repo. Walk them here, then do them for real.
        </p>
        <FirstPRWalkthrough />
      </div>
    </div>
  </section>

  <section class="section-padding bg-primary-100">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-4xl font-bold mb-10">Two other ways in</h2>
        <ul class="space-y-9 list-none p-0 m-0">
          {
            secondaryRoutes.map((route) => (
              <li>
                <h3 class="text-2xl font-bold mb-2">{route.label}</h3>
                <p class="text-brand-dark/70 m-0">{route.detail}</p>
                <a
                  href={route.href}
                  target={route.external ? '_blank' : undefined}
                  rel={route.external ? 'noopener noreferrer' : undefined}
                  class="inline-block font-display font-bold mt-3 text-brand-dark no-underline border-b-2 border-brand-pink hover:text-accent-700"
                >
                  {route.cta} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Our values</h2>
        <p class="text-lg text-brand-dark/70 m-0">
          Respect, marginalized voices leading, collaboration over competition, no tolerance for
          harassment. Written down rather than implied —
          <a
            href={`${links.github.website}/blob/main/CODE_OF_CONDUCT.md`}
            class="font-display font-bold text-brand-dark no-underline border-b-2 border-brand-pink hover:text-accent-700"
            >read the code of conduct</a
          >.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-brand-dark text-primary-100">
    <div class="container-custom text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to get started?</h2>
      <p class="text-xl mb-8 max-w-2xl mx-auto opacity-90">
        You find your people to build with you, not just for you.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={links.luma} external variant="secondary" size="lg">Come to a Lab</Button>
        <Button
          href="/contact"
          variant="outline"
          size="lg"
          class="!text-white !border-white hover:!bg-white/10"
        >
          Get in touch
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
