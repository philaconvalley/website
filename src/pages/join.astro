---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ClosingFlock from '../components/ClosingFlock.astro';
import { links } from '../config';
import { getCommunityData } from '../lib/community';
import { firstPrSteps } from '../data/first-pr';

/**
 * Join, Edition 1.2 (DESIGN.md, "The 1.2 redesign"). Sections follow Diego's
 * mockup, with these decisions (Waskar, 10/17/2026):
 * - The headline is "You already belong here." (the handbook's first value,
 *   Belonging). The mockup's "Show up before you feel ready." is About's
 *   closing headline.
 * - The role ladder shows only roles that mean something written down:
 *   Neighbor (given on joining), Builder (came through a workshop) and Voice
 *   (led a session), from community/discord/channel-map.md. Crew is the admin
 *   role and Connector has no definition, so neither is shown.
 * - The first PR walkthrough is the mockup's grid of six cards, with the real
 *   steps and commands (src/data/first-pr.ts). It replaces the interactive
 *   stepper.
 * - The values are three code-of-conduct lines, each backed by
 *   CODE_OF_CONDUCT.md. "Collaboration over competition" has no source.
 * - The Slack fallback stays, worded as what it is: a real backup for people
 *   who cannot reach Discord, but quieter (Waskar, 10/17/2026).
 * - "Come to a Lab" follows the empty-state rule: an RSVP only for a real
 *   event, "Get notified" otherwise.
 */

const { discord, nextEvent } = await getCommunityData();

const roles = [
  { name: 'Neighbor', line: 'You get it the moment you join.' },
  { name: 'Builder', line: 'You came through a workshop.' },
  { name: 'Voice', line: 'You led a session for the flock.' },
];

const values = [
  'Respect, every time',
  'Center marginalized voices',
  'Zero tolerance for harassment',
];

// Step number colors rotate through the accents, as in the mockup.
const dots = [
  'bg-brand-yellow',
  'bg-brand-amber',
  'bg-brand-pink',
  'bg-brand-coral',
  'bg-brand-yellow',
];

const goodFirstIssues = `${links.github.website}/issues?q=${encodeURIComponent(
  'is:issue is:open label:"good first issue"',
)}`;
---

<BaseLayout
  title="Join — Find your people at PhilaCon Valley"
  description="You already belong here. Join the flock on Discord, open your first pull request on our repo, or come to a free Lab in Philadelphia."
>
  <!-- Hero: Golden Yellow, with the real Discord server and its live count. -->
  <section class="bg-brand-yellow">
    <div class="container-custom py-[clamp(56px,8vw,112px)] flex flex-wrap gap-12 items-center justify-between">
      <div class="grow shrink basis-[560px] min-w-0 flex flex-col gap-7">
        <p class="m-0 self-start pill font-black text-[13px] tracking-[0.16em]">
          Join the community
        </p>
        <h1 class="m-0 [text-wrap:balance]">You already belong here.</h1>
        <p class="m-0 max-w-[560px] text-[clamp(18px,1.6vw,22px)] leading-[1.5] font-semibold">
          The flock talks, shares and builds on Discord between nights. Say hi, ask the question you
          think is too basic, and find your people.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <Button href={links.discord} external variant="primary" size="lg">
            Join the Discord
          </Button>
          <Button href="#first-pr" variant="light" size="lg">
            Make your first PR
          </Button>
        </div>
        <p class="m-0 max-w-[520px] text-[15px] leading-[1.5]" data-testid="slack-fallback">
          Discord blocked where you are?{' '}
          <a
            href={links.slack}
            target="_blank"
            rel="noopener noreferrer"
            class="font-black text-brand-dark underline underline-offset-[4px] decoration-2"
          >
            Join our Slack
          </a>{' '}
          instead. It's quieter than Discord, but it's a real backup.
        </p>
      </div>
      <figure class="m-0 grow-0 shrink basis-[360px] min-w-0 flex flex-col items-center gap-5">
        <img
          src="/images/discord-mascot.webp"
          alt=""
          width="600"
          height="600"
          class="block w-full max-w-[360px] aspect-square rounded-full border-2 border-brand-dark shadow-[10px_10px_0_theme(colors.brand.dark)] object-cover"
        />
        <figcaption
          class="pill bg-white normal-case tracking-normal text-sm"
          data-testid="discord-count"
        >
          {discord.name} · {discord.memberCount} members · {discord.onlineCount} online now
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- The flock: Discord roles that mark what someone has done. The ladder
       plays with the night system (Waskar, 10/17/2026), so the build-up from
       Neighbor to Voice happens in order as it scrolls into view: each card
       rises, and its number pops in as it arrives. -->
  <script is:inline src="/js/night-arm.js"></script>
  <section class="bg-brand-amber border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-12">
      <div class="flex flex-wrap justify-between items-end gap-8">
        <div class="flex flex-col gap-[22px] max-w-[760px]">
          <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">The flock</p>
          <h2 class="m-0 [text-wrap:balance]">Start as a Neighbor. Grow from there.</h2>
        </div>
        <p class="m-0 max-w-[380px] text-[17px] leading-[1.55]">
          Roles on our Discord mark what you've done with the flock, so people know who to ask.
        </p>
      </div>
      <ol
        class="m-0 p-0 list-none grid gap-5 grid-cols-1 sm:grid-cols-3"
        data-testid="discord-roles"
        data-night-strip
      >
        {roles.map((role, i) => (
          <li class="flex">
            <div
              data-night-rise
              class:list={[
                'w-full rounded-[20px] border-2 border-brand-dark p-6 flex flex-col gap-3 shadow-[6px_6px_0_theme(colors.brand.dark)]',
                i === roles.length - 1 ? 'bg-brand-dark text-white' : 'bg-white',
              ]}
            >
              <span
                data-night-dot
                class="self-start origin-left font-black text-[13px] tracking-[0.14em]"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3
                class:list={[
                  'm-0 text-[32px] leading-none',
                  i === roles.length - 1 && 'text-brand-yellow',
                ]}
              >
                {role.name}
              </h3>
              <p class="m-0 text-[15px] leading-[1.5]">{role.line}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <script is:inline defer src="/js/night.js"></script>
  <!-- Your first pull request: six real steps on this site's own repo. The id
       is the target of "Make your first PR" here and on /projects. -->
  <section id="first-pr" class="bg-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,128px)] flex flex-col gap-12">
      <div class="flex flex-wrap justify-between items-end gap-8">
        <div class="flex flex-col gap-[22px] max-w-[760px]">
          <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">
            Your first pull request
          </p>
          <h2 class="m-0 [text-wrap:balance]">Six steps. Practice on our repo.</h2>
        </div>
        <p class="m-0 max-w-[380px] text-[17px] leading-[1.55]">
          Try it here first, on the website you're looking at, before you do it anywhere else.
        </p>
      </div>
      <ol
        class="m-0 p-0 list-none grid gap-6 grid-cols-[repeat(auto-fill,minmax(min(300px,100%),1fr))]"
        data-testid="first-pr-steps"
      >
        {firstPrSteps.map((step, i) => {
          const last = i === firstPrSteps.length - 1;
          return (
            <li
              class:list={[
                'rounded-[24px] border-2 border-brand-dark p-6 flex flex-col gap-3',
                last
                  ? 'bg-brand-dark text-white shadow-[6px_6px_0_theme(colors.brand.pink)]'
                  : 'bg-white shadow-[6px_6px_0_theme(colors.brand.dark)]',
              ]}
            >
              <div class="flex items-center gap-3">
                <span
                  class:list={[
                    'flex-none inline-flex items-center justify-center size-8 rounded-full border-2 border-brand-dark font-black text-sm text-brand-dark',
                    last ? 'bg-brand-yellow' : dots[i % dots.length],
                  ]}
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <h3 class:list={['m-0 text-[28px] leading-tight', last && 'text-brand-yellow']}>
                  {step.title}
                </h3>
              </div>
              <p class="m-0 text-[16px] leading-[1.55]">{step.lead}</p>
              {step.code && <pre class="m-0 mt-auto rounded-[12px] bg-brand-dark text-brand-yellow p-4 font-mono text-[13px] leading-[1.6] whitespace-pre-wrap [overflow-wrap:anywhere]"><code>{step.code}</code></pre>}
              {step.note && <p class="m-0 text-[14px] leading-[1.5] font-semibold">{step.note}</p>}
              {last && (
                <p class="m-0 mt-auto font-display font-extrabold text-xl uppercase">
                  That's it. You're a contributor.
                </p>
              )}
            </li>
          );
        })}
      </ol>
      <div class="rounded-[18px] border-2 border-brand-dark bg-brand-yellow px-6 py-3 flex flex-wrap items-center gap-x-8 gap-y-1">
        <p class="m-0 font-black text-[17px]">Stuck? That's normal.</p>
        <a
          href={goodFirstIssues}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-11 font-black text-[17px] text-brand-dark underline underline-offset-[5px] decoration-2"
        >
          Find a good first issue
        </a>
        <a
          href="/resources/first-pull-request"
          class="inline-flex items-center min-h-11 font-black text-[17px] text-brand-dark underline underline-offset-[5px] decoration-2"
        >
          Read the longer guide
        </a>
        <a
          href={links.discord}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-11 font-black text-[17px] text-brand-dark underline underline-offset-[5px] decoration-2"
        >
          Ask on Discord
        </a>
      </div>
    </div>
  </section>

  <!-- Two other ways in, and how we treat each other: ink, as in the mockup. -->
  <section class="bg-brand-dark text-white border-t-2 border-brand-dark">
    <div class="container-custom py-[clamp(72px,9vw,120px)] flex flex-col gap-12">
      <div class="flex flex-col gap-[22px] max-w-[760px]">
        <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase">Two other ways in</p>
        <h2 class="m-0 text-white [text-wrap:balance]">
          Not ready to code? <span class="text-brand-yellow">Still come.</span>
        </h2>
      </div>
      <ul class="m-0 p-0 list-none grid gap-6 grid-cols-1 md:grid-cols-2">
        <li class="rounded-[20px] border-2 border-brand-dark bg-white text-brand-dark p-7 flex flex-col gap-3">
          <h3 class="m-0 text-[clamp(30px,2.8vw,40px)] leading-none">Come to a Lab</h3>
          <p class="m-0 text-[16px] leading-[1.55]">
            Free, in person, and no experience required. The fastest way to meet the flock.
          </p>
          {nextEvent ? (
            <a
              href={nextEvent.url}
              target="_blank"
              rel="noopener noreferrer"
              data-pcv-event-start={nextEvent.start}
              data-pcv-event-fallback={links.luma}
              class="self-start inline-flex items-center min-h-11 font-black text-[15px] text-brand-dark underline underline-offset-[5px] decoration-2"
            >
              <span data-pcv-event-start={nextEvent.start}>RSVP on Luma</span>
              <span hidden data-pcv-event-after={nextEvent.start}>
                Get notified
              </span>
            </a>
          ) : (
            <a
              href={links.luma}
              target="_blank"
              rel="noopener noreferrer"
              class="self-start inline-flex items-center min-h-11 font-black text-[15px] text-brand-dark underline underline-offset-[5px] decoration-2"
            >
              Get notified
            </a>
          )}
        </li>
        <li class="rounded-[20px] border-2 border-brand-dark bg-brand-pink text-brand-dark p-7 flex flex-col gap-3">
          <h3 class="m-0 text-[clamp(30px,2.8vw,40px)] leading-none">Keep it free</h3>
          <p class="m-0 text-[16px] leading-[1.55]">
            Help cover the space and the hardware so the next person walks in at no cost.
          </p>
          <a
            href="/support"
            class="self-start inline-flex items-center min-h-11 font-black text-[15px] text-brand-dark underline underline-offset-[5px] decoration-2"
          >
            Support the flock
          </a>
        </li>
      </ul>
      <div class="pt-10 border-t-2 border-white/80 flex flex-wrap items-start gap-x-12 gap-y-6">
        <div class="grow-0 shrink basis-[280px] flex flex-col gap-3">
          <p class="m-0 font-black text-[13px] tracking-[0.2em] uppercase text-brand-yellow">
            Our values
          </p>
          <h3 class="m-0 text-[clamp(26px,2.4vw,34px)] leading-none text-white">
            How we treat each other.
          </h3>
        </div>
        <ul
          class="grow shrink basis-[420px] m-0 p-0 list-none flex flex-wrap gap-3"
          data-testid="join-values"
        >
          {values.map((value, i) => (
            <li
              class:list={[
                'rounded-[12px] border-2 px-4 py-2.5 font-extrabold text-[17px]',
                i === values.length - 1
                  ? 'border-brand-yellow text-brand-yellow'
                  : 'border-white text-white',
              ]}
            >
              {value}
            </li>
          ))}
        </ul>
        <a
          href={`${links.github.website}/blob/main/CODE_OF_CONDUCT.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-11 font-black text-[15px] text-white underline underline-offset-[5px] decoration-2"
        >
          Read the code of conduct
        </a>
      </div>
    </div>
  </section>

  <!-- The Join closing, in the mockup's copy. -->
  <ClosingFlock
    lede="A pigeon flies alone. A flock goes much further."
    primary={{ href: '/events', label: 'Come to a Lab' }}
    secondary={{ href: '/contact', label: 'Get in touch' }}
  >
    Ready to get started?
  </ClosingFlock>
</BaseLayout>
