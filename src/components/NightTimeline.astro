---
import { labNight } from '../data/lab-night';

/**
 * How a night goes: the five steps of a Lab or PATCH night (src/data/lab-night.ts),
 * as a timeline that draws itself. Used on About and Events (Waskar,
 * 10/16/2026); one per page, because night.js plays the first strip it finds.
 *
 * Motion: night-arm.js hides the steps before paint; night.js plays them
 * (styles in global.css, "night timeline"). Each step has a dot; a segment
 * draws from it to the next dot. Horizontal from 1024px, vertical below,
 * where a two-column grid could not carry one line.
 */
interface Props {
  /** The heading inside the strip. */
  title?: string;
}

const { title = 'How a night goes' } = Astro.props;
---

{/* Parser-blocking on purpose: hides the timeline before it paints. */}
<script is:inline src="/js/night-arm.js"></script>
<div
  class="rounded-retro border-2 border-brand-dark bg-brand-yellow text-brand-dark p-6 md:p-8 flex flex-col gap-6"
  data-testid="night-strip"
  data-night-strip
>
  <h3 class="m-0 text-2xl leading-none">{title}</h3>
  <ol class="m-0 p-0 list-none grid gap-x-6 gap-y-6 grid-cols-1 lg:grid-cols-5">
    {labNight.map((step, i) => (
      <li class="relative pl-9 lg:pl-0 lg:pt-9">
        <span
          data-night-dot
          aria-hidden="true"
          class={`absolute left-0 top-0.5 lg:top-0 size-4 rounded-full border-2 border-brand-dark ${i === labNight.length - 1 ? 'bg-brand-pink' : 'bg-white'}`}
        />
        {i < labNight.length - 1 && (
          <span
            data-night-seg
            aria-hidden="true"
            class="absolute left-[7px] top-6 -bottom-5 w-0.5 bg-brand-dark lg:left-6 lg:-right-5 lg:top-[7px] lg:bottom-auto lg:w-auto lg:h-0.5"
          />
        )}
        <div data-night-rise class="flex flex-col gap-1">
          <span class="font-black text-[13px] tracking-[0.14em]">{step.time}</span>
          <span class="font-display font-extrabold text-xl uppercase leading-tight">
            {step.title}
          </span>
          <span class="text-[15px] leading-[1.5]">{step.line}</span>
        </div>
      </li>
    ))}
  </ol>
</div>
<script is:inline defer src="/js/night.js"></script>
