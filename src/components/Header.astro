---
import { getCommunityData, formatEventDate } from '../lib/community';
import { links } from '../config';

/**
 * The redesign shows a three-link nav (Community / Studio / Stories). That is an
 * information architecture the site does not have yet — collapsing to three real
 * links today would orphan five reachable pages, so the full nav is kept and the
 * design's *styling* is applied to it. Revisit if the IA is ever consolidated.
 */
const navItems = [
  { name: 'About', href: '/about' },
  { name: 'Events', href: '/events' },
  { name: 'Projects', href: '/projects' },
  { name: 'Arcade', href: '/arcade' },
  { name: 'Resources', href: '/resources' },
  // Blog is hidden until an editorial procedure exists — see src/pages/_blog/.
  // { name: 'Blog', href: '/blog' },
  { name: 'Join', href: '/join' },
  { name: 'Support', href: '/support' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;

const { nextEvent } = await getCommunityData();
const eventDate = nextEvent ? formatEventDate(nextEvent.start) : null;
// With no event, the header asks people to follow the Luma calendar instead
// of offering an RSVP with nothing behind it.
const rsvpHref = nextEvent?.url ?? links.luma;
---

<!--
  Fully opaque, deliberately. This bar was bg-primary-100/95 with a blur, which
  went unnoticed for as long as every page scrolled cream-on-cream underneath
  it. The arcade sends a dark cabinet and a saturated marquee beneath it, and at
  95% you could read a game's title through the nav links. A heavier blur turned
  that into a soft tint, but a sticky bar that still smudges whatever passes
  under it is a bar that keeps getting revisited every time the site gains a
  high-contrast page. Opaque ends the class of bug rather than this instance.
  Edition 1.2 (10/15/2026): the bar is Golden Yellow with a 2px ink edge, and
  the mobile menu is opaque too — the Book rules out frosted glass.
  The mark (chosen in the 10/15/2026 header prototype): the pigeon head hangs
  over the ink edge at the top of the page, the Book's "Mascot + wordmark"
  primary lockup on a mascot-forward surface. Once the visitor scrolls, or
  opens the phone menu, it tucks inside the bar so it never covers content.
-->
<header class="sticky top-0 z-50 bg-brand-yellow border-b-2 border-brand-dark">
  <nav
    class="container-custom"
    x-data="{ mobileMenuOpen: false, scrolled: window.scrollY > 8, ready: false }"
    x-init="requestAnimationFrame(() => requestAnimationFrame(() => (ready = true)))"
    @scroll.window.passive="scrolled = window.scrollY > 8"
  >
    <div class="flex items-center justify-between h-[64px] lg:h-[74px]">
      <!-- Mark + wordmark. The mark's box keeps the tucked size, so the layout
           never shifts; only the image and the name transform. pr-4 reserves the
           room the name shifts into, inside the link's box, so the focus ring
           wraps the whole wordmark and the name never meets the first nav link. "Hang" scales
           the head up from its top-left corner, tilts it, and drops it 8px over
           the edge. Hang is the server-rendered default, so a page that loads at the
           top never moves. Under reduced motion the head stays tucked: no hang, so no
           state change and no jump on scroll. A reload partway down the page starts
           tucked: `ready` keeps the transition off until the first state has painted,
           so only a real scroll animates (Waskar, 10/16/2026). -->
      <a
        href="/"
        class="flex-shrink-0 flex items-center gap-1 pr-4 rounded-2xl font-display font-extrabold text-xl md:text-2xl lg:text-xl xl:text-2xl leading-none tracking-[-0.01em] text-brand-dark"
      >
        <span class="relative block w-12 h-12 lg:w-14 lg:h-14 mr-2" aria-hidden="true">
          <img
            src="/images/pigeon-head-mark-160.webp"
            alt=""
            width="56"
            height="56"
            class="absolute inset-0 w-full h-full origin-top-left drop-shadow-[3px_3px_0_#1A1A1A] transition-transform duration-[240ms] ease-in-out motion-reduce:transition-none translate-y-2 -rotate-6 scale-[1.36] motion-reduce:!transform-none"
            :class="{ 'translate-y-2 -rotate-6 scale-[1.36]': !(scrolled || mobileMenuOpen), '!transition-none': !ready }"
          />
        </span>
        <span
          class="block transition-transform duration-[240ms] ease-in-out motion-reduce:transition-none translate-x-4 motion-reduce:!transform-none"
          :class="{ 'translate-x-4': !(scrolled || mobileMenuOpen), '!transition-none': !ready }"
        >
          <!-- The official wordmark, unchanged from the brand logo library. Its
               built-in ink outline is what the Book asks for on pink-on-yellow. -->
          <img
            src="/images/philacon-wordmark-horizontal.svg"
            alt="PhilaCon Valley"
            width="216"
            height="20"
            class="block h-4 xl:h-[18px] w-auto"
          />
        </span>
      </a>

      <!-- Desktop Navigation -->
      <!--
        Baloo 2 loads remotely with `display=swap` (BaseLayout.astro), so the
        browser paints these links in a fallback font first, then swaps in
        the real one — which changes every link's rendered width. x-init
        measures the pill's initial position/width from offsetLeft/offsetWidth
        before that swap is guaranteed to have happened, and nothing else
        re-measures it: the pill would sit wherever the fallback font put it,
        wrong and permanent, until the visitor's first hover/focus on the
        nav. The `document.fonts.ready` correction below re-measures once the
        real font is in, skipped only while the visitor is already hovering
        (their own mouseenter measurement is already correct by then).
        `instant` starts true, so the first measurement and this correction
        snap into place instead of sliding: the pill used to shrink over 200ms
        on every first visit (Waskar, 10/16/2026). The slide is for following
        the pointer, so the first mouseenter turns it on.
      -->
      <div class="hidden lg:block">
        <div
          data-testid="desktop-nav"
          class="relative flex items-center space-x-0.5"
          x-data="{ pos: { left: 0, width: 0 }, instant: true }"
          x-init="const current = $el.querySelector('[aria-current=page]'); if (current) pos = { left: current.offsetLeft, width: current.offsetWidth }; if (document.fonts) document.fonts.ready.then(() => { if (!$el.matches(':hover')) { const c = $el.querySelector('[aria-current=page]'); if (c) pos = { left: c.offsetLeft, width: c.offsetWidth } } })"
          @mouseleave="instant = false; const current = $el.querySelector('[aria-current=page]'); if (current) pos = { left: current.offsetLeft, width: current.offsetWidth }"
          @focusout="if (!$el.contains($event.relatedTarget)) { instant = true; const current = $el.querySelector('[aria-current=page]'); if (current) pos = { left: current.offsetLeft, width: current.offsetWidth } }"
        >
          <!-- The pill spans the whole nav, and clip-path shows only the part
               under the current link. Animating clip-path, not width, keeps
               the move off layout (motion review, 10/17/2026), and the inset's
               `round` keeps the ends fully round, which scaleX would squash.
               The right inset is calc(100% - right edge), so it follows the
               nav's own width: a pixel inset went stale for a frame when the
               webfont swap narrowed the nav. -->
          <div
            x-cloak
            data-testid="nav-pill"
            class="absolute inset-y-1 inset-x-0 bg-accent-400 transition-[clip-path] duration-200 ease-out motion-reduce:transition-none"
            :class="instant && '!transition-none'"
            :style="`clip-path: inset(0 calc(100% - ${pos.left + pos.width}px) 0 ${pos.left}px round 9999px);`"
          ></div>
          {navItems.map((item) => {
            const isCurrent = currentPath === item.href || currentPath.startsWith(item.href + '/');
            // Full ink in every state. The pill behind the current link is Hot
            // Pink (accent-400), where white text fails AA and ink passes. The
            // other links used to sit at 60% ink, which reads as grey on yellow.
            // No hover underline: the sliding pill already follows the pointer.
            // The pill slides for the mouse and jumps for the keyboard: Tab is
            // keyboard-initiated, and keyboard actions get no animation.
            return (
              <a
                href={item.href}
                aria-current={isCurrent ? 'page' : undefined}
                @mouseenter="instant = false; pos = { left: $el.offsetLeft, width: $el.offsetWidth }"
                @focus="instant = true; pos = { left: $el.offsetLeft, width: $el.offsetWidth }"
                class="relative z-10 px-2 xl:px-2.5 py-1.5 rounded-full text-[15px] xl:text-base font-display font-extrabold text-brand-dark"
              >
                {item.name}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Next event + RSVP. The date is a quiet inline row on desktop; on phones
           it lives in the thumb-reachable bottom bar instead (see EventBar). -->
      <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
        {eventDate && (
          <span
            data-pcv-event-start={nextEvent!.start}
            class="hidden xl:inline font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-brand-dark"
          >
            {eventDate}
          </span>
        )}
        <!-- Brand Book 1.2 p14: Hot Pink fill, ink outline, ink offset shadow. The
             only hover the Book names is "shadow grows", which reads here because
             the ink shadow sits on yellow, not behind an ink button (the old fill).
             Both attributes are the static-build guard, continued client-side: once
             the visitor's clock passes the event, the date row removes itself and
             this CTA falls back to the Luma calendar ("Get notified") rather than
             deep-linking a closed event page. See BaseLayout.astro. -->
        <a
          href={rsvpHref}
          target="_blank"
          rel="noopener noreferrer"
          {...(nextEvent
            ? {
                'data-pcv-event-start': nextEvent.start,
                'data-pcv-event-fallback': links.luma,
              }
            : {})}
          data-testid="hero-cta"
          class="inline-flex items-center gap-2 min-h-[48px] font-display font-extrabold text-base xl:text-[17px] px-4 xl:px-6 py-2.5 rounded-full border-2 border-brand-dark bg-accent-400 text-brand-dark lift lift-sm"
        >
          {nextEvent ? (
            <>
              <span data-pcv-event-start={nextEvent.start}>RSVP</span>
              <span hidden data-pcv-event-after={nextEvent.start}>
                Get notified
              </span>
            </>
          ) : (
            'Get notified'
          )}
          {/* From 1024 to 1279px the nav is full, and "Get notified" is 50px
              wider than "RSVP". The arrow and some padding make room there. */}
          <svg
            class="hidden xl:block w-4 h-4"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button
          x-ref="menuButton"
          aria-controls="mobile-menu"
          @click="mobileMenuOpen = !mobileMenuOpen"
          type="button"
          class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] rounded-full border-2 border-brand-dark bg-white text-brand-dark shadow-retro-sm"
          :aria-expanded="mobileMenuOpen.toString()"
        >
          <span class="sr-only">Open main menu</span>
          <svg
            class="h-6 w-6"
            :class="{ 'hidden': mobileMenuOpen, 'block': !mobileMenuOpen }"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 8h16M4 16h16"
            ></path>
          </svg>
          <svg
            class="h-6 w-6"
            :class="{ 'block': mobileMenuOpen, 'hidden': !mobileMenuOpen }"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu. The negative margins cancel container-custom's side padding,
         so the ink panel runs edge to edge instead of leaving yellow strips. -->
    <div
      x-show="mobileMenuOpen"
      x-cloak
      id="mobile-menu"
      data-testid="mobile-menu"
      x-transition:enter="transition ease-out duration-200 motion-reduce:duration-150"
      x-transition:enter-start="opacity-0 -translate-y-2 motion-reduce:translate-y-0"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-out duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-2 motion-reduce:translate-y-0"
      class="lg:hidden -mx-4 sm:-mx-6 bg-brand-dark border-t-2 border-brand-dark"
      @click.away="mobileMenuOpen = false"
      @keydown.escape.window="if (mobileMenuOpen) { mobileMenuOpen = false; $refs.menuButton.focus() }"
    >
      <div class="px-1 sm:px-3 pt-2 pb-3 space-y-1">
        {navItems.map((item) => {
          const isCurrent = currentPath === item.href || currentPath.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              aria-current={isCurrent ? 'page' : undefined}
              class={`block px-3 py-2.5 rounded-lg text-base font-display font-extrabold ${
                isCurrent
                  ? 'bg-accent-400 text-brand-dark'
                  : 'text-white hover:bg-accent-400 hover:text-brand-dark'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </div>
    </div>
  </nav>
</header>
