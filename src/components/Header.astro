---
import { getCommunityData, formatEventDate } from '../lib/community';

/**
 * The redesign shows a three-link nav (Community / Studio / Stories). That is an
 * information architecture the site does not have yet — collapsing to three real
 * links today would orphan five reachable pages, so the full nav is kept and the
 * design's *styling* is applied to it. Revisit if the IA is ever consolidated.
 */
const navItems = [
  { name: 'About', href: '/about' },
  { name: 'Events', href: '/events' },
  { name: 'Projects', href: '/projects' },
  { name: 'Resources', href: '/resources' },
  // Blog is hidden until an editorial procedure exists — see src/pages/_blog/.
  // { name: 'Blog', href: '/blog' },
  { name: 'Join', href: '/join' },
  { name: 'Support', href: '/support' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;

const { nextEvent } = await getCommunityData();
const eventDate = nextEvent ? formatEventDate(nextEvent.start) : null;
const rsvpHref = nextEvent?.url ?? '/events';
---

<header class="sticky top-0 z-50 bg-brand-dark">
  {
    /* The design's scroll rule, sitting where a border-bottom used to. The track
      is the border; the fill is the progress. Rendered on every page because the
      header is, and driven by src/scripts/scroll-progress.ts — on a page too
      short to scroll it stays at zero width and reads as a plain dark rule. */
  }
  <div class="absolute inset-x-0 bottom-0 h-[3px] bg-white/[0.12]" aria-hidden="true">
    <div data-pcv-progress class="h-full w-full bg-brand-pink origin-left scale-x-0"></div>
  </div>
  <nav class="container-custom" x-data="{ mobileMenuOpen: false }">
    {
      /* 62px, not the 68px this carried before: it is the height the motion
        system's HEADER_OFFSET has always assumed when it parks a pinned section
        or lands a smooth-scrolled anchor. The two disagreed by 6px until now. */
    }
    <div class="flex items-center justify-between h-[62px]">
      {
        /* Still the wordmark as type, not public/images/philacon-valley-wordmark.webp
          as the design does. That asset is a two-line stacked lockup at 1200x675;
          at the design's own `height:32px` it renders about 57px wide and neither
          word is legible. Type at this size is readable and selectable. */
      }
      <a
        href="/"
        class="flex-shrink-0 font-display font-extrabold text-base md:text-[17px] tracking-tight text-brand-cream"
      >
        PhilaCon Valley
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:block">
        <div
          data-testid="desktop-nav"
          class="relative flex items-center space-x-0.5"
          x-data="{ pos: { left: 0, width: 0 } }"
          x-init="const current = $el.querySelector('[aria-current=page]'); if (current) pos = { left: current.offsetLeft, width: current.offsetWidth }"
          @mouseleave="const current = $el.querySelector('[aria-current=page]'); if (current) pos = { left: current.offsetLeft, width: current.offsetWidth }"
          @focusout="if (!$el.contains($event.relatedTarget)) { const current = $el.querySelector('[aria-current=page]'); if (current) pos = { left: current.offsetLeft, width: current.offsetWidth } }"
        >
          <div
            x-cloak
            data-testid="nav-pill"
            class="absolute inset-y-1 left-0 rounded-full bg-accent-400 transition-[transform,width] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none"
            :style="`transform: translateX(${pos.left}px); width: ${pos.width}px;`"
          >
          </div>
          {
            navItems.map((item) => {
              const isCurrent =
                currentPath === item.href || currentPath.startsWith(item.href + '/');
              return (
                <a
                  href={item.href}
                  aria-current={isCurrent ? 'page' : undefined}
                  @mouseenter="pos = { left: $el.offsetLeft, width: $el.offsetWidth }"
                  @focus="pos = { left: $el.offsetLeft, width: $el.offsetWidth }"
                  class={`relative z-10 px-3 py-1.5 rounded-full text-sm font-display font-semibold transition-colors ${
                    isCurrent
                      ? // Dark, not white: the pill behind this is accent-400 (#FF66A8),
                        // where white text measures 2.72:1 against a 4.5:1 requirement
                        // at 14px. brand-dark on the same pink is 6.40:1.
                        'text-brand-dark'
                      : // At rest this is now white/70 on #1A1A1A (6.6:1) rather than
                        // dark on cream. The hover and focus colour is unchanged and
                        // still load-bearing for the same reason as above: the pill
                        // slides under whichever link you point at, so a hovered link
                        // is sitting on pink and must be dark to stay readable.
                        'text-white/70 hover:text-brand-dark focus-visible:text-brand-dark'
                  }`}
                >
                  {item.name}
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Next event + RSVP. The date is a quiet inline row on desktop; on phones
           it lives in the thumb-reachable bottom bar instead (see EventBar). -->
      <div class="hidden lg:flex items-center gap-4 flex-shrink-0">
        {
          eventDate && (
            <span
              data-pcv-event-start={nextEvent!.start}
              class="hidden xl:inline font-mono text-[10px] font-medium uppercase tracking-[0.12em] text-white/70 animate-fade-in"
            >
              {eventDate}
            </span>
          )
        }
        <!-- Both attributes are the static-build guard, continued client-side: once
             the visitor's clock passes the event, the date row removes itself and
             this CTA falls back to /events rather than deep-linking a closed Luma
             page. See BaseLayout.astro.

             The ink shadow and border are cream rather than dark: a dark offset
             shadow on a #1A1A1A header is invisible, which is what the design
             solved by inverting both. Hover still lifts the face up and left into
             a deeper shadow, the same gesture every other pill on the site makes. -->
        <a
          href={rsvpHref}
          {...nextEvent
            ? {
                target: '_blank',
                rel: 'noopener noreferrer',
                'data-pcv-event-start': nextEvent.start,
                'data-pcv-event-fallback': '/events',
              }
            : {}}
          data-testid="hero-cta"
          class="font-display font-bold text-[15px] px-6 py-3 rounded-full bg-brand-pink text-brand-dark border-2 border-brand-cream shadow-[3px_3px_0_#FFEED0] transition-all duration-150 ease-out hover:-translate-x-px hover:-translate-y-px hover:shadow-[5px_5px_0_#FFEED0] motion-safe:active:scale-[0.97] motion-reduce:active:opacity-80 motion-reduce:transition-none"
        >
          RSVP →
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden">
        <button
          @click="mobileMenuOpen = !mobileMenuOpen"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-md text-brand-cream hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-accent-400"
          :aria-expanded="mobileMenuOpen.toString()"
        >
          <span class="sr-only">Open main menu</span>
          <svg
            class="h-6 w-6"
            :class="{ 'hidden': mobileMenuOpen, 'block': !mobileMenuOpen }"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 8h16M4 16h16"></path>
          </svg>
          <svg
            class="h-6 w-6"
            :class="{ 'block': mobileMenuOpen, 'hidden': !mobileMenuOpen }"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      x-show="mobileMenuOpen"
      x-cloak
      data-testid="mobile-menu"
      x-transition:enter="transition ease-out duration-200 motion-reduce:duration-0"
      x-transition:enter-start="opacity-0 -translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150 motion-reduce:duration-0"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-2"
      class="lg:hidden bg-brand-dark/90 backdrop-blur-lg border-t border-white/10"
      @click.away="mobileMenuOpen = false"
      @keydown.escape.window="mobileMenuOpen = false"
    >
      <div class="px-2 pt-2 pb-3 space-y-1">
        {
          navItems.map((item) => {
            const isCurrent = currentPath === item.href || currentPath.startsWith(item.href + '/');
            return (
              <a
                href={item.href}
                aria-current={isCurrent ? 'page' : undefined}
                class={`block px-3 py-2 rounded-lg text-base font-display font-bold ${
                  isCurrent
                    ? 'bg-accent-400 text-brand-dark'
                    : 'text-primary-100 hover:bg-accent-400 hover:text-brand-dark'
                }`}
              >
                {item.name}
              </a>
            );
          })
        }
      </div>
    </div>
  </nav>
</header>
