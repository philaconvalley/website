---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'light' | 'ink' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  external?: boolean;
  'data-testid'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  external = false,
  'data-testid': testId,
} = Astro.props;

// Book section 10: a flat fill, a 2px ink outline, stadium radius, and a hard
// ink shadow. The focus ring comes from the global `:focus-visible` rule, so
// buttons, links, and inputs all share one ring. The transition and press
// classes are motion; the `animate` skill owns them (DESIGN.md, motion rule 9).
const baseClasses =
  'inline-flex items-center justify-center gap-2 font-display font-extrabold rounded-full transition-[transform,background-color,box-shadow] duration-150 ease-out motion-safe:active:scale-[0.97] motion-reduce:active:opacity-80';

// Every filled variant has ink text: ink reads on all the warm fills, and
// white on Hot Pink fails AA (Book section 04, "Contrast").
const filled =
  'border-2 border-brand-dark shadow-retro hover:shadow-retro-lg hover:-translate-y-0.5';

const variantClasses = {
  // Main call to action.
  primary: `${filled} bg-brand-pink text-brand-dark`,
  // Second action on a white or ink section.
  secondary: `${filled} bg-brand-yellow text-brand-dark`,
  // Second action on a yellow or saturated section, where secondary would vanish.
  light: `${filled} bg-white text-brand-dark`,
  // Strongest action on a yellow or saturated section.
  ink: `${filled} bg-brand-dark text-white`,
  // Tertiary. Takes the text color it sits on, so it also works on dark fields.
  outline: 'border-2 border-current bg-transparent text-brand-dark hover:bg-brand-dark/5',
};

// Every size clears the 44px touch target.
const sizeClasses = {
  sm: 'min-h-[44px] px-5 py-2 text-sm',
  md: 'min-h-[48px] px-6 py-3 text-base',
  lg: 'min-h-[52px] px-8 py-3.5 text-lg',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;

const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class={classes} data-testid={testId} {...externalProps}>
    <slot />
    {external && (
      <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
        />
      </svg>
    )}
  </a>
) : (
  <button class={classes} data-testid={testId}>
    <slot />
  </button>
)}
