---
import { photoSrcset } from '../lib/events';

/**
 * Photos from the room, each on an ink-bordered card with its own caption
 * (site audit, 10/18/2026). Used by the event recap page for all of its
 * photos, and by Home and Support for a row of four. Every gallery entry has a
 * caption (src/content.config.ts), so no photo falls back to the event title.
 *
 * The photos are not links, so the cards do not move on hover.
 */
interface Photo {
  image: string;
  alt: string;
  caption: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<ul
  class="m-0 p-0 list-none grid gap-4 md:gap-5 grid-cols-2 lg:grid-cols-4"
  data-testid="photo-grid"
>
  {photos.map((photo) => (
    <li>
      <figure class="m-0 h-full flex flex-col overflow-hidden rounded-[20px] border-2 border-brand-dark bg-white shadow-retro-lg">
        <img
          src={photo.image}
          srcset={photoSrcset(photo.image)}
          sizes="(min-width: 1024px) 300px, 50vw"
          width="800"
          height="800"
          loading="lazy"
          decoding="async"
          alt={photo.alt}
          class="block w-full aspect-square object-cover"
        />
        <figcaption class="flex-1 border-t-2 border-brand-dark px-3.5 py-3 font-bold text-[14px] leading-[1.35]">
          {photo.caption}
        </figcaption>
      </figure>
    </li>
  ))}
</ul>
