---
interface Photo {
  image: string;
  alt: string;
  event: string;
  date: Date;
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// The caption is always visible, on a solid white band under the photo. It
// used to sit on a gradient (the Book: "No gradients") and show only on
// hover, so phones never showed it.
---

{photos.length > 0 ? (
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {photos.map((photo) => (
      <figure class="group relative flex flex-col overflow-hidden rounded-retro border-2 border-brand-dark bg-white shadow-retro-lg">
        <div class="overflow-hidden">
          <img
            src={photo.image}
            alt={photo.alt}
            loading="lazy"
            class="w-full aspect-square object-cover transition-transform duration-300 ease-out motion-safe:group-hover:scale-105"
          />
        </div>
        <figcaption class="flex-1 border-t-2 border-brand-dark p-3">
          <p class="text-brand-dark text-xs font-display font-extrabold">{photo.event}</p>{' '}
          {photo.caption && <p class="text-brand-dark text-xs">{photo.caption}</p>}
        </figcaption>
      </figure>
    ))}
  </div>
) : (
  <div class="text-center py-12 px-6 rounded-retro border-2 border-dashed border-brand-dark">
    <p class="text-lg font-display font-bold text-brand-dark/70 mb-2">Photos are on their way</p>
    <p class="text-brand-dark/50 max-w-md mx-auto">
      We're gathering shots from Commit, Ship It, and our Labs — check back after our next event to
      see the community in action.
    </p>
  </div>
)}
