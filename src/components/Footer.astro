---
import { site, links } from '../config';

const currentYear = new Date().getFullYear();

/**
 * Edition 1.2 redesign (10/15/2026): an ink field with three labeled columns of
 * links, after the redesign mockup. Text is white, not white at reduced alpha —
 * the Book has no greys, and 45% white on ink read as grey.
 *
 * Left block (decided in the 10/15/2026 footer review): the yellow wordmark
 * and one line, as in the mockup. Brand Book §07 puts the wordmark, not the
 * mascot, in footers, and the header already carries the mascot. The motto
 * lives in ClosingFlock, the section above the footer, once each page PR
 * places it. Privacy sits in the bottom row with the other site-level links.
 *
 * Social links stay real links, and Slack in the old mock is Discord — the main
 * community channel since the 2026-08 move away from Slack.
 */
const columns = [
  {
    label: 'Explore',
    links: [
      { name: 'About', href: '/about' },
      { name: 'Events', href: '/events' },
      { name: 'Projects', href: '/projects' },
      { name: 'Arcade', href: '/arcade' },
      { name: 'Resources', href: '/resources' },
      // Blog is hidden until an editorial procedure exists — see src/pages/_blog/.
    ],
  },
  {
    label: 'Get involved',
    links: [
      { name: 'Join', href: '/join' },
      { name: 'Support', href: '/support' },
      { name: 'Contact', href: '/contact' },
      // The mockup adds "Start a project". It returns when a real page exists.
    ],
  },
  {
    label: 'Find us',
    external: true,
    links: [
      { name: 'Discord', href: links.discord },
      { name: 'Luma', href: links.luma },
      { name: 'Instagram', href: links.social.instagram },
      { name: 'LinkedIn', href: links.social.linkedin },
      { name: 'GitHub', href: links.github.org },
    ],
  },
];
---

<footer class="bg-brand-dark text-white">
  <div class="container-custom py-[60px] lg:py-[96px] lg:pb-10">
    <div class="flex flex-col lg:flex-row lg:justify-between gap-12">
      <div class="max-w-[560px]">
        <!-- The wordmark is the footer's only route home: the columns deliberately
             do not repeat Home, and clicking the name is the convention a visitor
             who has read to the bottom of a long page will reach for first. -->
        <a
          href="/"
          class="inline-block font-display font-extrabold uppercase text-brand-yellow text-[2.5rem] lg:text-[4rem] leading-[0.95] tracking-[-0.015em] hover:underline decoration-4 underline-offset-8"
        >
          PhilaCon Valley
        </a>
        <!-- Non-breaking hyphen and space, so "in-person" and "Philadelphia, PA"
             never split across lines. -->
        <p class="mt-5 mb-0 max-w-[26rem] font-sans text-lg text-white">
          Come as you are. Leave with a flock. A free, in&#8209;person tech community in{' '}
          {site.location.replace(' ', '\u00a0')}.
        </p>
      </div>

      <div class="flex flex-wrap gap-x-14 gap-y-10">
        {columns.map((column) => (
          <nav aria-label={column.label} class="flex flex-col gap-3">
            <p class="m-0 font-sans text-xs font-black uppercase tracking-[0.2em] text-brand-amber">
              {column.label}
            </p>
            {column.links.map((link) => (
              <a
                href={link.href}
                {...(column.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="font-sans font-bold text-base text-white hover:text-brand-yellow hover:underline decoration-2 underline-offset-4"
              >
                {link.name}
              </a>
            ))}
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-12 lg:mt-16 pt-6 border-t border-white flex flex-col lg:flex-row lg:justify-between gap-3 font-sans font-bold text-sm text-white">
      <span>
        {site.location} ·{' '}
        <a
          href={`mailto:${site.email}`}
          class="hover:text-brand-yellow hover:underline underline-offset-4"
        >
          {site.email}
        </a>
      </span>
      <span class="flex flex-wrap gap-x-6 gap-y-2">
        <a
          href={links.github.website}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-brand-yellow hover:underline underline-offset-4"
        >
          This site is open source
        </a>
        <a href="/privacy" class="hover:text-brand-yellow hover:underline underline-offset-4">
          Privacy
        </a>
        <span>© {currentYear} PhilaCon Valley</span>
      </span>
    </div>
  </div>
</footer>
