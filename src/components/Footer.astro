---
import { site, links } from '../config';

const currentYear = new Date().getFullYear();

/**
 * The redesign reduces the footer to one statement and a single hairline row of
 * links. The four-column sitemap it replaces was doing navigation work the
 * header already does; what it could not do is land the closing line.
 *
 * Kept as real links rather than the design's plain text — the design renders
 * "Slack · Luma · Instagram · GitHub" unlinked because a static mock has nowhere
 * to go, not because these should be dead. Slack in that mock is now Discord —
 * the main community channel, per the 2026-08 move away from Slack.
 */
const connect = [
  { name: 'Discord', href: links.discord },
  { name: 'Luma', href: links.luma },
  { name: 'Instagram', href: links.social.instagram },
  { name: 'LinkedIn', href: links.social.linkedin },
  { name: 'GitHub', href: links.github.org },
];

const secondary = [
  { name: 'About', href: '/about' },
  { name: 'Events', href: '/events' },
  { name: 'Projects', href: '/projects' },
  { name: 'Resources', href: '/resources' },
  // Blog is hidden until an editorial procedure exists — see src/pages/_blog/.
  // { name: 'Blog', href: '/blog' },
  { name: 'Join', href: '/join' },
  { name: 'Support', href: '/support' },
  { name: 'Contact', href: '/contact' },
];
---

<footer class="bg-brand-dark text-primary-100">
  <div class="container-custom py-[60px] lg:py-[104px] lg:pb-[60px]">
    <!-- The logo is the footer's only route home: the link row below deliberately
         does not repeat Home, and clicking the mark is the convention a visitor
         who has read to the bottom of a long page will reach for first. -->
    <a href="/" aria-label="PhilaCon Valley home" class="inline-block mb-6 lg:mb-8">
      <img
        src="/images/sunset philacon valley logo.webp"
        alt="PhilaCon Valley — a pigeon on a keyboard with the Philadelphia skyline"
        width="132"
        height="132"
        loading="lazy"
        class="w-[108px] lg:w-[132px] h-auto block"
      />
    </a>

    <h2
      class="font-display font-extrabold text-[32px] lg:text-[52px] leading-[1.1] lg:leading-[1.06] tracking-tight text-primary-100 max-w-[720px] m-0"
    >
      A pigeon flies alone. A flock goes much further.
    </h2>

    <!-- Secondary navigation: everything the header carries, still reachable
         from the bottom of the page without reproducing a four-column sitemap. -->
    <nav
      aria-label="Footer"
      class="mt-10 lg:mt-14 flex flex-wrap gap-x-6 gap-y-3 font-display font-semibold text-sm"
    >
      {
        secondary.map((link) => (
          <a href={link.href} class="text-primary-100/60 hover:text-accent-400 transition-colors">
            {link.name}
          </a>
        ))
      }
    </nav>

    <div
      class="mt-10 lg:mt-[60px] pt-5 lg:pt-6 border-t border-white/10 flex flex-col lg:flex-row lg:justify-between gap-2 font-mono text-[11px] lg:text-xs text-primary-100/45"
    >
      <span>{site.location}</span>
      <span class="flex flex-wrap gap-x-2">
        {
          connect.map((link, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent-400 transition-colors"
              >
                {link.name}
              </a>
            </>
          ))
        }
      </span>
      <span class="flex flex-wrap gap-x-2">
        <a href={`mailto:${site.email}`} class="hover:text-accent-400 transition-colors">
          {site.email}
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={links.github.website}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-400 transition-colors">Open source</a
        >
        <span aria-hidden="true">·</span>
        <span>© {currentYear}</span>
      </span>
    </div>
  </div>
</footer>
