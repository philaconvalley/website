---
import Button from './Button.astro';
import { links } from '../config';

/**
 * The closing section every page ends on (DESIGN.md, "Color rhythm"): the motto
 * on Golden Yellow, type only (decided 10/15/2026). The lettered sunset logo,
 * the large pigeon head, and a generic block skyline were each tried and removed:
 * the logo and the head repeated a brand mark already in view (header, footer),
 * and the skyline was not Philadelphia. Real asset or absent.
 *
 * The redesign mockup drew this section in sky blue. The Book says Sky Blue is
 * never a background, so it is Golden Yellow (decided 10/15/2026).
 *
 * Page PRs place it as the last element inside <main>, and drop the page's own
 * closing call to action so the page does not ask twice.
 */
interface Props {
  /** One or two sentences under the motto. Keep it to the single ask. */
  lede?: string;
}

const { lede = "Come to one night. That's the whole ask. We'll take it from there, together." } =
  Astro.props;
---

<section
  data-testid="closing-flock"
  class="relative overflow-hidden bg-brand-yellow border-t-2 border-brand-dark"
>
  <div class="container-custom py-16 lg:py-28 flex flex-col gap-10">
    <div class="flex-1 min-w-0 flex flex-col gap-7">
      <h2 class="m-0">
        A pigeon flies alone. <span class="sticker bg-white">A flock</span> goes much further.
      </h2>
      <p class="m-0 max-w-[32rem] text-lg lg:text-xl font-semibold">{lede}</p>
      <div class="flex flex-wrap gap-4">
        <!-- Book p14: on a yellow field the main button is Hot Pink. -->
        <Button href={links.luma} external variant="primary" size="lg">
          RSVP for the next night
        </Button>
        <Button href="/support" variant="light" size="lg">
          Support the flock
        </Button>
      </div>
    </div>
  </div>
</section>
