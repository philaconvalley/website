---
/**
 * The Lab story, told as a horizontal timeline: you arrive, you build (with
 * others or on your own), you leave with a thing. The times follow
 * src/data/lab-night.ts, checked against Luma (Waskar, 10/16/2026).
 *
 * The left-to-right travel IS the argument, which is why this stays horizontal
 * at every width rather than stacking on phones — stacked, it becomes a bulleted
 * list of times and stops meaning anything. It is decorative narration of the
 * prose beside it, so the whole block is aria-hidden and the timeline is also
 * stated in text for anyone who never sees the animation.
 */
interface Props {
  /** What the last Lab produced. */
  outcome: string;
  /** One line on why that outcome matters. */
  outcomeDetail: string;
}

const { outcome, outcomeDetail } = Astro.props;

const dots = [
  { color: 'bg-brand-yellow', motion: 'pcv-loop-join-left' },
  { color: 'bg-brand-purple', motion: 'pcv-loop-solo' },
  { color: 'bg-brand-salmon', motion: 'pcv-loop-join-right' },
];
---

<div data-lab-track class="relative h-[186px] lg:h-[230px] lg:max-w-[460px]" aria-hidden="true">
  <!-- Track: a static hairline, with the coral line drawing itself along it -->
  <div class="absolute inset-x-0 top-[58px] lg:top-[96px] h-px bg-brand-dark/[0.14]"></div>
  <div class="absolute left-0 top-[58px] lg:top-[96px] h-px bg-accent-600 pcv-loop-track"></div>

  <!-- The three people -->
  <div class="absolute left-[8%] lg:left-[6%] top-[44px] lg:top-[79px] flex gap-1.5 lg:gap-2">
    {dots.map((dot) => (
      <span
        class={`block w-[15px] h-[15px] lg:w-5 lg:h-5 rounded-full ${dot.color} ${dot.motion}`}
      />
    ))}
  </div>

  <!-- Two defences, because absolute siblings have no idea the other exists.
       The mobile tops clear the outcome chip, which bottoms out at 93px on
       phones; at the design's 86px this row ran underneath it, and the chip,
       opaque and later in DOM order, painted over "you arrive alone" at every
       width up to ~430px. The z-10 then
       covers what geometry cannot: pcvChip rises in from translateY(12px), so
       mid-animation it reaches into this row no matter where the row sits, and a
       longer `outcome` string would grow the chip back into it. Text on top means
       the failure mode is at worst a crowded frame, never hidden words. Above
       `lg` the chip sits clear on its own. e2e/lab-track.spec.ts. -->
  <div class="absolute z-10 left-0 top-[102px] lg:top-[126px] font-mono text-[9px] lg:text-[10px] font-medium uppercase tracking-[0.14em] text-brand-dark/45">
    6:00pm · you arrive
  </div>
  <div class="absolute z-10 left-0 top-[120px] lg:top-[148px] font-mono text-[9px] lg:text-[10px] font-medium uppercase tracking-[0.14em] text-brand-dark/45 pcv-loop-label">
    7:15pm · build together or solo
  </div>

  <!-- What you leave with -->
  <div class="absolute right-0 top-0.5 lg:top-1.5 w-[214px] lg:w-[242px] bg-white rounded-[14px] px-4 py-3.5 lg:px-[18px] lg:py-4 shadow-retro pcv-loop-chip">
    <div class="font-mono text-[9px] lg:text-[10px] font-medium uppercase tracking-[0.14em] text-accent-600">
      9:00pm · you leave with
    </div>
    <div class="font-display font-bold text-[17px] lg:text-[19px] leading-tight mt-1.5">
      {outcome}
    </div>
    <div class="text-[13px] lg:text-sm text-brand-dark/[0.66] mt-1 leading-snug">
      {outcomeDetail}
    </div>
  </div>
</div>

<!-- Pauses the loop while it is off screen (public/js/lab-track.js). A served
     file, not inline: the CSP allows scripts from this origin only. -->
<script is:inline defer src="/js/lab-track.js"></script>

<!-- Same story, for screen readers and for anyone the animation never reaches. -->
<p class="sr-only">
  A Lab runs from 6:00pm, when you arrive, through 7:15pm, when you build together or on your own,
  to 9:00pm, when you leave with {outcome} — {outcomeDetail}
</p>
