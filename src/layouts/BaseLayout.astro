---
// Self-hosted fonts, bundled from node_modules — not loaded from Google Fonts.
// Every page view used to send the visitor's IP address to Google, which the
// privacy page then had to disclose. Served from our own origin they fall under
// `font-src 'self'`, and Dependabot sees version bumps. Each file covers one
// weight, split by unicode-range, so a browser downloads only the scripts a page
// uses. Baloo 2 stops at 800: `font-black` (900) renders as 800, as it always has.
// Nunito ships 900 for the small uppercase labels and pills (Book section 05).
import '@fontsource/baloo-2/400.css';
import '@fontsource/baloo-2/600.css';
import '@fontsource/baloo-2/700.css';
import '@fontsource/baloo-2/800.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/600-italic.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
// The heading face, preloaded below. Vite returns the same hashed file the
// font CSS points at, so the preload and the CSS share one download.
import headingFont from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "PhilaCon Valley - Philadelphia's tech community by us, for us. Centering Black, Brown, LGBTQIA+, and underrepresented folks in tech.",
  image = '/images/1200x675 banner.webp',
  type = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Fonts use font-display: swap, and the browser finds a font file only
         after it reads the CSS. On a first visit the first frame painted in
         the fallback face, which is wider: Home's headline wrapped to five
         lines (542px), then reflowed to four when Baloo 2 arrived (Waskar,
         10/16/2026). Preloading the heading face fetches it alongside the CSS,
         so it is ready for the first paint. -->
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <!-- Icons are generated from the brand mark by `npm run icons:generate`.
         The tab icons keep their transparency; the Apple one cannot, because
         iOS discards alpha and composites onto black, which would swallow the
         mark's black outline. See scripts/generate-icons.mjs. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1A1A1A" />

    <SEO title={title} description={description} image={image} type={type} />

    <!-- Alpine.js — bundled from node_modules rather than loaded from a CDN.
         Alpine is the only JavaScript that reaches a visitor's browser, and as a
         CDN tag it was the one dependency with no integrity guarantee (CSP checks
         the origin, not the bytes) and no manifest entry, so Dependabot could not
         see it either. Importing it here serves it from our own origin under
         `script-src 'self'`, puts version bumps under Dependabot, and removes a
         third-party failure domain: if the origin serving this is down, the page
         it belongs to is already down. Note this does NOT remove the need for
         'unsafe-eval' — Alpine evaluates x-* directives through `new Function`
         wherever it is hosted. See e2e/csp.spec.ts. -->
    <script>
      import Alpine from 'alpinejs';

      window.Alpine = Alpine;
      Alpine.start();
    </script>
    <meta name="generator" content={Astro.generator} />

    <Analytics />

    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "PhilaCon Valley",
        "url": "https://www.philaconvalley.com",
        "logo": "https://www.philaconvalley.com/images/sunset-philacon-valley-logo-264.webp",
        "description": "Philadelphia's tech community by us, for us. Centering Black, Brown, LGBTQIA+, and underrepresented folks in tech.",
        "sameAs": [
          "https://github.com/philaconvalley",
          "https://www.instagram.com/phlconvalley/",
          "https://www.linkedin.com/company/philaconvalley/",
          "https://x.com/PhlConValley"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Philadelphia",
          "addressRegion": "PA",
          "addressCountry": "US"
        }
      }
    </script>
  </head>
  <body>
    <!-- While it has focus, the skip link is a full-width ink strip above the
         header, in the page flow, so it pushes the header down instead of
         covering the logo (it used to float over the top-left corner). The
         pink outline sits inside the strip (negative offset), because the ink
         edge of the focus ring is invisible on an ink strip. White on ink is
         17.4:1; it was white on #D98E1C, about 2.6:1, and off palette. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:block focus:w-full focus:py-3 focus:text-center focus:bg-brand-dark focus:text-white focus:font-display focus:font-extrabold focus:outline-offset-[-6px]"
    >
      Skip to main content
    </a>
    {/* Header and Footer live here, not in each page, so the landmark structure is
        guaranteed by construction: the header element is the banner landmark and
        the footer element is contentinfo only while they sit outside main, and the
        skip link above only actually skips the nav if main starts after the nav.
        Pages render page content into the slot and nothing else. */}
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <!-- Expires time-bound claims against the visitor's clock, which a static build
         cannot do on its own. Served from public/ and loaded with `is:inline` so it
         stays an external file: Astro's script pipeline inlines chunks this small,
         and an inline script would need its sha256 hand-maintained in both CSP
         policies in vercel.json. As a file it is covered by `script-src 'self'`.
         Full reasoning in public/js/event-freshness.js. -->
    <script is:inline defer src="/js/event-freshness.js"></script>
  </body>
</html>
