{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalUrl": {
      "type": "string",
      "format": "uri"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Substack",
        "Medium",
        "YouTube",
        "Dev.to",
        "LinkedIn",
        "Podcast",
        "Other"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "author",
    "date"
  ]
}