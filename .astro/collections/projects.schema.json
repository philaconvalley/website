{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "techStack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "githubUrl": {
      "type": "string",
      "format": "uri"
    },
    "liveUrl": {
      "type": "string",
      "format": "uri"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "techStack",
    "contributors",
    "status",
    "date"
  ]
}